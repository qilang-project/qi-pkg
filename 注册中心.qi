// qi-pkg · 注册中心 —— 五个 HTTP 端点的客户端
//
//   GET  /api/v1/packages                          包列表
//   GET  /api/v1/packages/{name}                   包详情（含全部版本）
//   GET  /api/v1/packages/{name}/{version}         单版本元数据（sha256 从这里来）
//   GET  /api/v1/packages/{name}/{version}/download  tar.gz 包体
//   PUT  /api/v1/packages/{name}/{version}         发布，Bearer token
//
// 协议合同见 qi/docs/包管理设计.md。线上协议键一律英文，中文只出现在给人看的提示里。
// 中文包名走 percent-encode 进路径段。
//
// ── 两处「必须走字节、不能走 qi 字符串」的地方 ─────────────────────
//
// 上行：PUT 的 body 是 **base64(tar.gz)**，不是裸字节。注册中心是 qi-web 写的，
// 收请求体时会把内嵌的 0x00 逐个换成空格以维持 C 串约定 —— gzip 里遍地 0x00，
// 裸传上去长度不变、只坏几个字节，只有 sha256 才露馅。
//
// 下行：包体走 HTTP.下载文件 直接落盘（Rust 侧 fs::write 原始字节），
// 再用 字节切片.读取文件 读回来。绝不能用 HTTP.获取 —— 那条路要过 qi 字符串。
//
// 请求走 HTTP.打开流：它**阻塞到响应头到达**，所以状态码立刻可读，
// 能把「没这个版本(404)」和「服务挂了」分开 —— 普通的 HTTP.获取 只给正文。

包 Pkg;

导入 标准库.字符串;
导入 标准库.字节切片 作为 字节库;
导入 标准库.列表 作为 表列;
导入 标准库.操作系统 作为 系统;
导入 标准库.HTTP;
导入 标准库.JSON 作为 J;

// 默认注册中心地址（可用 QI_REGISTRY 覆盖，测试指本地假服务）。
公开 函数 默认地址() : 字符串 { 返回 "https://pkg.qilang.org"; }

// 发布 token 的环境变量名。
公开 函数 令牌环境变量() : 字符串 { 返回 "QI_REGISTRY_TOKEN"; }

// 上一次请求的状态码与正文 —— qi 的函数只能返回一个值，
// 而「404 还是 500」跟「正文是什么」两个都得知道。
变量 上次状态码: 整数 = 0;
变量 上次正文: 字符串 = "";
变量 上次网络错: 字符串 = "";

公开 函数 状态码() : 整数 { 返回 上次状态码; }
公开 函数 正文() : 字符串 { 返回 上次正文; }
公开 函数 网络错() : 字符串 { 返回 上次网络错; }

// 当前生效的注册中心基地址（去掉尾部 /，方便拼接）。
公开 函数 地址() : 字符串 {
    变量 原始: 字符串 = 字符串::去空白(系统.获取环境变量("QI_REGISTRY"));
    如果 (字符串::字节长度(原始) == 0) { 原始 = 默认地址(); }
    当 (字符串::结束于(原始, "/") == 1 && 字符串::字节长度(原始) > 1) {
        原始 = 字符串::子串(原始, 0, 字符串::字节长度(原始) - 1);
    }
    返回 原始;
}

// ══════════════════════════════════════════════════════════════════
// URL 路径段转义
// ══════════════════════════════════════════════════════════════════

函数 十六(值: 整数) : 字符串 {
    返回 字符串::子串("0123456789ABCDEF", 值 & 15, 1);
}

// 只留 URL 里安全的那些：字母数字与 - _ . ~ 以及 unreserved 之外常见的安全字符。
// 中文是非 ASCII，逐字节 %XX（跟 Rust 的 utf8_percent_encode 一致）。
// `/ ? # %` 空格 必须转，否则会把路径结构撕开。
函数 免转义(一字节: 整数) : 整数 {
    如果 (一字节 >= 48 && 一字节 <= 57) { 返回 1; }   // 0-9
    如果 (一字节 >= 65 && 一字节 <= 90) { 返回 1; }   // A-Z
    如果 (一字节 >= 97 && 一字节 <= 122) { 返回 1; }  // a-z
    如果 (一字节 == 45 || 一字节 == 95 || 一字节 == 46 || 一字节 == 126) { 返回 1; }  // - _ . ~
    如果 (一字节 == 33 || 一字节 == 36 || 一字节 == 38 || 一字节 == 39) { 返回 1; }   // ! $ & '
    如果 (一字节 == 40 || 一字节 == 41 || 一字节 == 42 || 一字节 == 43) { 返回 1; }   // ( ) * +
    如果 (一字节 == 44 || 一字节 == 58 || 一字节 == 59 || 一字节 == 61) { 返回 1; }   // , : ; =
    如果 (一字节 == 64 || 一字节 == 91 || 一字节 == 93 || 一字节 == 124) { 返回 1; }  // @ [ ] |
    如果 (一字节 == 94) { 返回 1; }                                                   // ^
    返回 0;
}

公开 函数 转义路径段(原始: 字符串) : 字符串 {
    变量 片: 整数 = 字节库.从字符串(原始);
    变量 总长: 整数 = 字节库.长度(片);
    变量 输出: 字符串 = "";
    变量 i: 整数 = 0;
    当 (i < 总长) {
        变量 一字节: 整数 = 字节库.获取(片, i);
        如果 (免转义(一字节) == 1) {
            输出 = 输出 + 字符串::子串(原始, i, 1);
        } 否则 {
            输出 = 输出 + "%" + 十六(一字节 >> 4) + 十六(一字节);
        }
        i = i + 1;
    }
    字节库.释放切片(片);
    返回 输出;
}

// ══════════════════════════════════════════════════════════════════
// 请求
// ══════════════════════════════════════════════════════════════════

函数 收全(流: 整数) : 字符串 {
    变量 输出: 字符串 = "";
    变量 读着: 整数 = 1;
    当 (读着 == 1) {
        变量 块: 字符串 = HTTP.读取流(流, 60000);
        如果 (字符串::字节长度(块) > 0) {
            输出 = 输出 + 块;
        } 否则 {
            如果 (HTTP.流状态(流) != 0) { 读着 = 0; }
        }
    }
    返回 输出;
}

// 发一条请求，正文与状态码进全局。返回 1 成功发出（不管状态码），0 = 连不上。
公开 函数 请求(方法: 字符串, 完整地址: 字符串, 头JSON: 字符串, 请求体: 字符串) : 整数 {
    上次状态码 = 0;
    上次正文 = "";
    上次网络错 = "";
    // 连接超时 30 秒；总时限 10 分钟（发大包和慢网都可能超过默认值）
    变量 流: 整数 = HTTP.打开流(方法, 完整地址, 头JSON, 请求体, 30000, 600000);
    如果 (流 < 0) {
        上次网络错 = "无法连接注册中心 " + 完整地址
            + "（HTTP.打开流 返回 " + 流 + "）\n  检查网络，或用环境变量 QI_REGISTRY 指向可达的注册中心";
        返回 0;
    }
    上次状态码 = HTTP.流状态码(流);
    上次正文 = 收全(流);
    如果 (HTTP.流状态(流) == 3) {
        上次网络错 = HTTP.流错误(流);
    }
    HTTP.关闭流(流);
    返回 1;
}

// 非 2xx 时把 {"error":"…"} 抽出来；抽不出就退回原始正文片段。
公开 函数 错误原因() : 字符串 {
    如果 (字符串::字节长度(上次正文) > 0) {
        变量 句柄: 整数 = J.解码(上次正文);
        如果 (句柄 > 0) {
            如果 (J.是否包含键(句柄, "error") == 1) {
                变量 原因: 字符串 = J.获取字符串(句柄, "error");
                J.删除(句柄);
                如果 (字符串::字节长度(原因) > 0) { 返回 原因; }
                返回 "（服务端未给出原因）";
            }
            J.删除(句柄);
        }
    }
    变量 净: 字符串 = 字符串::去空白(上次正文);
    如果 (字符串::字节长度(净) == 0) { 返回 "（服务端未给出原因）"; }
    如果 (字符串::字节长度(净) > 200) { 返回 字符串::子串(净, 0, 200); }
    返回 净;
}

// ══════════════════════════════════════════════════════════════════
// 端点
// ══════════════════════════════════════════════════════════════════

// GET /api/v1/packages —— 摘要四元组依次入表：名称, 最新版, 说明, 下载数。
// 失败返回 -1（原因看 网络错() / 错误原因()）。
公开 函数 列出包() : 整数 {
    如果 (请求("GET", 地址() + "/api/v1/packages", "", "") == 0) { 返回 -1; }
    如果 (上次状态码 < 200 || 上次状态码 >= 300) { 返回 -1; }
    变量 根: 整数 = J.解码(上次正文);
    如果 (根 <= 0) {
        上次网络错 = "注册中心返回的包列表不是预期 JSON";
        返回 -1;
    }
    变量 版本数组: 整数 = J.获取数组(根, "packages");
    变量 结果值: 整数 = 表列.创建字符串列表();
    如果 (版本数组 > 0) {
        变量 个数: 整数 = J.数组长度(版本数组);
        变量 i: 整数 = 0;
        当 (i < 个数) {
            变量 一条: 整数 = J.数组获取对象(版本数组, i);
            如果 (一条 > 0) {
                表列.添加字符串(结果值, J.获取字符串(一条, "name"));
                表列.添加字符串(结果值, J.获取字符串(一条, "latest"));
                表列.添加字符串(结果值, J.获取字符串(一条, "description"));
                表列.添加字符串(结果值, "" + J.获取整数(一条, "downloads"));
                J.删除(一条);
            }
            i = i + 1;
        }
        J.删除(版本数组);
    }
    J.删除(根);
    返回 结果值;
}

// GET /api/v1/packages/{name}/{version} —— 返回该版本的 sha256。
// 404（没这个版本）返回 ""，且 状态码() == 404；出错也返回 "" 但状态码不是 404。
公开 函数 取版本指纹(名称: 字符串, 版本: 字符串) : 字符串 {
    变量 网址: 字符串 = 地址() + "/api/v1/packages/" + 转义路径段(名称)
        + "/" + 转义路径段(版本);
    如果 (请求("GET", 网址, "", "") == 0) { 返回 ""; }
    如果 (上次状态码 == 404) { 返回 ""; }
    如果 (上次状态码 < 200 || 上次状态码 >= 300) { 返回 ""; }
    变量 句柄: 整数 = J.解码(上次正文);
    如果 (句柄 <= 0) { 返回 ""; }
    变量 指纹: 字符串 = J.获取字符串(句柄, "sha256");
    J.删除(句柄);
    返回 指纹;
}

// GET /api/v1/packages/{name}/{version}/download —— 落盘。返回字节数，负数是错误。
公开 函数 下载到文件(名称: 字符串, 版本: 字符串, 落盘路径: 字符串) : 整数 {
    变量 网址: 字符串 = 地址() + "/api/v1/packages/" + 转义路径段(名称)
        + "/" + 转义路径段(版本) + "/download";
    返回 HTTP.下载文件(网址, 落盘路径);
}

// PUT /api/v1/packages/{name}/{version} —— body 是 base64(tar.gz)。
// 返回 HTTP 状态码；0 表示根本没连上。
公开 函数 发布包体(名称: 字符串, 版本: 字符串, 包体: 整数, 令牌: 字符串) : 整数 {
    变量 网址: 字符串 = 地址() + "/api/v1/packages/" + 转义路径段(名称)
        + "/" + 转义路径段(版本);
    变量 编码后: 字符串 = 字节库.转Base64(包体);
    // 服务端不看 Content-Type，标成 text/plain 是为了让抓包的人一眼看出
    // 这是 base64 文本而不是二进制包体
    变量 头JSON: 字符串 = "{\"Authorization\":\"Bearer " + 令牌
        + "\",\"Content-Type\":\"text/plain; charset=utf-8\"}";
    如果 (请求("PUT", 网址, 头JSON, 编码后) == 0) { 返回 0; }
    返回 上次状态码;
}
