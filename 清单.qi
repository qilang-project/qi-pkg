// qi-pkg · 清单 —— qi.toml / qi.lock / 安装标记 的读写
//
// 只做包管理用得着的那点 TOML：节头 + `键 = "值"`。不引 标准库.配置 是因为
// 它把文件读成一个不透明句柄，取不出「[依赖] 表里都有哪些键」，而枚举依赖正是
// 这里最主要的活。另一半原因是**写**：改 qi.toml 必须逐行编辑，反序列化再写回
// 会重排键、丢注释、给中文表头加引号 —— 用户手写的清单被工具改得面目全非
// 是最招人烦的事。
//
// qi.lock 与 Rust 版（qi/src/package.rs）读写同一份文件：写出来的是
// `"格式版本" = 1` + `["根包"]` + 若干 `[["包"]]`，键一律带引号（中文裸键在
// TOML 1.0 里非法，Rust 那边的 toml crate 也是这么写的）。读的时候两种都认。

包 Pkg;

导入 标准库.字符串;
导入 标准库.字节切片 作为 字节库;
导入 标准库.列表 作为 表列;
导入 标准库.输入输出 作为 IO;
导入 标准库.路径 作为 路径库;

// ══════════════════════════════════════════════════════════════════
// 逐行拆
// ══════════════════════════════════════════════════════════════════

公开 函数 拆行(文本: 字符串) : 整数 {
    变量 结果值: 整数 = 表列.创建字符串列表();
    变量 总长: 整数 = 字符串::字节长度(文本);
    变量 位置: 整数 = 0;
    当 (位置 <= 总长) {
        变量 行尾: 整数 = 位置;
        当 (行尾 < 总长 && 字符串::等于(字符串::子串(文本, 行尾, 1), "\n") == 0) {
            行尾 = 行尾 + 1;
        }
        表列.添加字符串(结果值, 字符串::子串(文本, 位置, 行尾 - 位置));
        位置 = 行尾 + 1;
    }
    返回 结果值;
}

// 去掉一段两边的引号（TOML 的键既可能写成 名称 也可能写成 "名称"）
公开 函数 去引号(文本: 字符串) : 字符串 {
    变量 净: 字符串 = 字符串::去空白(文本);
    如果 (字符串::字节长度(净) >= 2 && 字符串::开始于(净, "\"") == 1
          && 字符串::结束于(净, "\"") == 1) {
        返回 字符串::子串(净, 1, 字符串::字节长度(净) - 2);
    }
    返回 净;
}

// `[节名]` / `["节名"]` / `[[节名]]` / `["甲"."乙"]` → 归一成 `甲.乙`；不是节头返回 ""
公开 函数 节头名(一行: 字符串) : 字符串 {
    变量 净: 字符串 = 字符串::去空白(一行);
    如果 (字符串::开始于(净, "[") == 0) { 返回 ""; }
    如果 (字符串::结束于(净, "]") == 0) { 返回 ""; }
    变量 里头: 字符串 = 字符串::子串(净, 1, 字符串::字节长度(净) - 2);
    如果 (字符串::开始于(里头, "[") == 1 && 字符串::结束于(里头, "]") == 1) {
        里头 = 字符串::子串(里头, 1, 字符串::字节长度(里头) - 2);
    }
    // 点分段各自去引号
    变量 输出: 字符串 = "";
    变量 段起: 整数 = 0;
    变量 总长: 整数 = 字符串::字节长度(里头);
    当 (段起 <= 总长) {
        变量 段尾: 整数 = 段起;
        当 (段尾 < 总长 && 字符串::等于(字符串::子串(里头, 段尾, 1), ".") == 0) {
            段尾 = 段尾 + 1;
        }
        如果 (字符串::字节长度(输出) > 0) { 输出 = 输出 + "."; }
        输出 = 输出 + 去引号(字符串::子串(里头, 段起, 段尾 - 段起));
        段起 = 段尾 + 1;
    }
    返回 输出;
}

// 是不是数组表头 `[[…]]`
公开 函数 是数组节头(一行: 字符串) : 整数 {
    变量 净: 字符串 = 字符串::去空白(一行);
    如果 (字符串::开始于(净, "[[") == 1 && 字符串::结束于(净, "]]") == 1) { 返回 1; }
    返回 0;
}

// 一行 `键 = 值` 里的键（已去引号）；不是键值行返回 ""
公开 函数 行键(一行: 字符串) : 字符串 {
    变量 净: 字符串 = 字符串::去空白(一行);
    如果 (字符串::字节长度(净) == 0) { 返回 ""; }
    如果 (字符串::开始于(净, "#") == 1) { 返回 ""; }
    如果 (字符串::开始于(净, "[") == 1) { 返回 ""; }
    变量 等号: 整数 = 字符串::查找(净, "=");
    如果 (等号 <= 0) { 返回 ""; }
    返回 去引号(字符串::子串(净, 0, 等号));
}

// 一行 `键 = "值"` 里的字符串值；右边不是字符串字面量（内联表 / 数字 / 数组）返回 ""
公开 函数 行字符串值(一行: 字符串) : 字符串 {
    变量 净: 字符串 = 字符串::去空白(一行);
    变量 等号: 整数 = 字符串::查找(净, "=");
    如果 (等号 < 0) { 返回 ""; }
    变量 右边: 字符串 = 字符串::去空白(字符串::子串从位置(净, 等号 + 1));
    如果 (字符串::开始于(右边, "\"") == 0) { 返回 ""; }
    变量 里头: 字符串 = 字符串::子串从位置(右边, 1);
    变量 收尾: 整数 = 字符串::查找(里头, "\"");
    如果 (收尾 < 0) { 返回 ""; }
    返回 字符串::子串(里头, 0, 收尾);
}

// ══════════════════════════════════════════════════════════════════
// qi.toml
// ══════════════════════════════════════════════════════════════════

// 取 `[节名]` 下的某个字符串键。节名传 "" 表示文件开头没有节头的那段。
公开 函数 节内取值(文本: 字符串, 节名: 字符串, 键名: 字符串) : 字符串 {
    变量 行表: 整数 = 拆行(文本);
    变量 条数: 整数 = 表列.字符串列表大小(行表);
    变量 当前节: 字符串 = "";
    变量 答案: 字符串 = "";
    变量 i: 整数 = 0;
    当 (i < 条数 && 字符串::字节长度(答案) == 0) {
        变量 一行: 字符串 = 表列.获取字符串(行表, i);
        变量 头: 字符串 = 节头名(一行);
        如果 (字符串::字节长度(头) > 0) {
            当前节 = 头;
        } 否则 {
            如果 (字符串::等于(当前节, 节名) == 1
                  && 字符串::等于(行键(一行), 键名) == 1) {
                答案 = 行字符串值(一行);
                如果 (字符串::字节长度(答案) == 0) { 答案 = " "; }
            }
        }
        i = i + 1;
    }
    表列.删除列表(行表);
    如果 (字符串::等于(答案, " ") == 1) { 返回 ""; }
    返回 答案;
}

// `[节名]` 下的全部键值，交替放进一个字符串列表：键, 值, 键, 值 …
// 右边不是字符串字面量的（本地路径详细表、数组）值为 ""。调用方负责 删除列表。
公开 函数 节内键值(文本: 字符串, 节名: 字符串) : 整数 {
    变量 结果值: 整数 = 表列.创建字符串列表();
    变量 行表: 整数 = 拆行(文本);
    变量 条数: 整数 = 表列.字符串列表大小(行表);
    变量 当前节: 字符串 = "";
    变量 i: 整数 = 0;
    当 (i < 条数) {
        变量 一行: 字符串 = 表列.获取字符串(行表, i);
        变量 头: 字符串 = 节头名(一行);
        如果 (字符串::字节长度(头) > 0) {
            当前节 = 头;
        } 否则 {
            如果 (字符串::等于(当前节, 节名) == 1) {
                变量 键: 字符串 = 行键(一行);
                如果 (字符串::字节长度(键) > 0) {
                    表列.添加字符串(结果值, 键);
                    表列.添加字符串(结果值, 行字符串值(一行));
                }
            }
        }
        i = i + 1;
    }
    表列.删除列表(行表);
    返回 结果值;
}

公开 函数 包名(清单文本: 字符串) : 字符串 {
    返回 节内取值(清单文本, "包", "名称");
}

公开 函数 包版本(清单文本: 字符串) : 字符串 {
    返回 节内取值(清单文本, "包", "版本");
}

公开 函数 包描述(清单文本: 字符串) : 字符串 {
    返回 节内取值(清单文本, "元数据", "描述");
}

// 版本必须是「主.次.补」三段纯数字。这条判定是
// `[依赖] 海龟 = "0.1.0"`（注册中心）与 `[依赖] 本地 = "../本地"`（路径）的分水岭，
// 卡得死是故意的：放宽成「像版本就算」会让写歪的路径悄悄变成注册中心依赖。
公开 函数 版本合法(版本: 字符串) : 整数 {
    变量 总长: 整数 = 字符串::字节长度(版本);
    如果 (总长 == 0 || 总长 > 32) { 返回 0; }
    变量 段数: 整数 = 1;
    变量 本段位数: 整数 = 0;
    变量 位置: 整数 = 0;
    当 (位置 < 总长) {
        变量 一个: 字符串 = 字符串::子串(版本, 位置, 1);
        如果 (字符串::等于(一个, ".") == 1) {
            如果 (本段位数 == 0) { 返回 0; }
            段数 = 段数 + 1;
            本段位数 = 0;
        } 否则 {
            如果 (字符串::查找("0123456789", 一个) < 0) { 返回 0; }
            本段位数 = 本段位数 + 1;
        }
        位置 = 位置 + 1;
    }
    如果 (段数 != 3 || 本段位数 == 0) { 返回 0; }
    返回 1;
}

// 清单里声明的注册中心依赖，交替放进字符串列表：别名, 版本, 别名, 版本 …
// 按别名排序（跟 Rust 版一致，输出顺序稳定）。调用方负责 删除列表。
公开 函数 注册中心依赖(清单文本: 字符串) : 整数 {
    变量 全部: 整数 = 节内键值(清单文本, "依赖");
    变量 条数: 整数 = 表列.字符串列表大小(全部);
    变量 别名表: 整数 = 表列.创建字符串列表();
    变量 i: 整数 = 0;
    当 (i + 1 < 条数) {
        如果 (版本合法(表列.获取字符串(全部, i + 1)) == 1) {
            表列.添加字符串(别名表, 表列.获取字符串(全部, i));
        }
        i = i + 2;
    }
    // 按别名排序（选择排序，依赖条数是个位数）
    变量 个数: 整数 = 表列.字符串列表大小(别名表);
    变量 用过: 整数 = 表列.创建整数列表();
    变量 k: 整数 = 0;
    当 (k < 个数) {
        表列.添加整数(用过, 0);
        k = k + 1;
    }
    变量 结果值: 整数 = 表列.创建字符串列表();
    变量 轮: 整数 = 0;
    当 (轮 < 个数) {
        变量 最小位: 整数 = -1;
        变量 j: 整数 = 0;
        当 (j < 个数) {
            如果 (表列.获取整数(用过, j) == 0) {
                如果 (最小位 < 0) {
                    最小位 = j;
                } 否则 {
                    如果 (文本序(表列.获取字符串(别名表, j),
                                表列.获取字符串(别名表, 最小位)) < 0) {
                        最小位 = j;
                    }
                }
            }
            j = j + 1;
        }
        表列.设置整数(用过, 最小位, 1);
        变量 名: 字符串 = 表列.获取字符串(别名表, 最小位);
        表列.添加字符串(结果值, 名);
        表列.添加字符串(结果值, 取依赖版本(全部, 名));
        轮 = 轮 + 1;
    }
    表列.删除列表(用过);
    表列.删除列表(别名表);
    表列.删除列表(全部);
    返回 结果值;
}

函数 取依赖版本(键值表: 整数, 别名: 字符串) : 字符串 {
    变量 条数: 整数 = 表列.字符串列表大小(键值表);
    变量 i: 整数 = 0;
    当 (i + 1 < 条数) {
        如果 (字符串::等于(表列.获取字符串(键值表, i), 别名) == 1) {
            返回 表列.获取字符串(键值表, i + 1);
        }
        i = i + 2;
    }
    返回 "";
}

// 字节序比较（排序用）。qi 没有字符串大小比较原语，逐字节比。
公开 函数 文本序(甲: 字符串, 乙: 字符串) : 整数 {
    变量 a: 整数 = 字节库.从字符串(甲);
    变量 b: 整数 = 字节库.从字符串(乙);
    变量 na: 整数 = 字节库.长度(a);
    变量 nb: 整数 = 字节库.长度(b);
    变量 上限: 整数 = na;
    如果 (nb < 上限) { 上限 = nb; }
    变量 结论: 整数 = 0;
    变量 i: 整数 = 0;
    当 (i < 上限 && 结论 == 0) {
        变量 x: 整数 = 字节库.获取(a, i);
        变量 y: 整数 = 字节库.获取(b, i);
        如果 (x < y) { 结论 = -1; }
        如果 (x > y) { 结论 = 1; }
        i = i + 1;
    }
    如果 (结论 == 0) {
        如果 (na < nb) { 结论 = -1; }
        如果 (na > nb) { 结论 = 1; }
    }
    字节库.释放切片(a);
    字节库.释放切片(b);
    返回 结论;
}

// 清单里的依赖总条数（给「没有注册中心依赖」那句提示用）
公开 函数 依赖总数(清单文本: 字符串) : 整数 {
    变量 全部: 整数 = 节内键值(清单文本, "依赖");
    变量 条数: 整数 = 表列.字符串列表大小(全部) / 2;
    表列.删除列表(全部);
    返回 条数;
}

// ══════════════════════════════════════════════════════════════════
// 写依赖：逐行编辑，保留注释与其余表
// ══════════════════════════════════════════════════════════════════

公开 函数 写依赖(清单路径: 字符串, 名称: 字符串, 版本: 字符串) : 整数 {
    变量 文本: 字符串 = IO.读取文件(清单路径);
    变量 行表: 整数 = 拆行(文本);
    变量 条数: 整数 = 表列.字符串列表大小(行表);
    变量 新行: 字符串 = 名称 + " = \"" + 版本 + "\"";

    // 找 [依赖] 表头
    变量 头位: 整数 = -1;
    变量 i: 整数 = 0;
    当 (i < 条数 && 头位 < 0) {
        变量 头: 字符串 = 节头名(表列.获取字符串(行表, i));
        如果 (字符串::等于(头, "依赖") == 1 || 字符串::等于(头, "dependencies") == 1) {
            头位 = i;
        }
        i = i + 1;
    }

    变量 输出: 字符串 = "";
    如果 (头位 < 0) {
        // 没有 [依赖] 表就在末尾建一个
        输出 = 拼行(行表, 0, 条数);
        如果 (字符串::字节长度(字符串::去空白(输出)) > 0
              && 字符串::结束于(输出, "\n\n") == 0) {
            如果 (字符串::结束于(输出, "\n") == 0) { 输出 = 输出 + "\n"; }
            输出 = 输出 + "\n";
        }
        输出 = 输出 + "[依赖]\n" + 新行 + "\n";
    } 否则 {
        // 表范围：表头之后到下一个表头（或文件尾）
        变量 表尾: 整数 = 条数;
        变量 j: 整数 = 头位 + 1;
        当 (j < 条数 && 表尾 == 条数) {
            如果 (字符串::开始于(字符串::去空白(表列.获取字符串(行表, j)), "[") == 1) {
                表尾 = j;
            }
            j = j + 1;
        }
        // 已有同名条目 → 原地替换
        变量 命中: 整数 = -1;
        变量 k: 整数 = 头位 + 1;
        当 (k < 表尾 && 命中 < 0) {
            如果 (字符串::等于(行键(表列.获取字符串(行表, k)), 名称) == 1) {
                命中 = k;
            }
            k = k + 1;
        }
        如果 (命中 >= 0) {
            输出 = 拼行(行表, 0, 命中) + 新行 + "\n" + 拼行(行表, 命中 + 1, 条数);
        } 否则 {
            // 追加到表末尾（跳过尾部空行，让新条目紧跟已有的）
            变量 插入点: 整数 = 表尾;
            当 (插入点 > 头位 + 1
                && 字符串::字节长度(字符串::去空白(表列.获取字符串(行表, 插入点 - 1))) == 0) {
                插入点 = 插入点 - 1;
            }
            输出 = 拼行(行表, 0, 插入点) + 新行 + "\n" + 拼行(行表, 插入点, 条数);
        }
    }
    表列.删除列表(行表);
    // 拆行会在结尾多产生一个空行（末尾换行之后的空串），拼回来正好还原
    IO.写入文件(清单路径, 输出);
    返回 1;
}

函数 拼行(行表: 整数, 起: 整数, 止: 整数) : 字符串 {
    变量 条数: 整数 = 表列.字符串列表大小(行表);
    变量 真止: 整数 = 止;
    如果 (真止 > 条数) { 真止 = 条数; }
    变量 输出: 字符串 = "";
    变量 i: 整数 = 起;
    当 (i < 真止) {
        // 最后一条是「末尾换行之后」的空串，不该再补一个换行
        如果 (i == 条数 - 1 && 字符串::字节长度(表列.获取字符串(行表, i)) == 0) {
            i = i + 1;
        } 否则 {
            输出 = 输出 + 表列.获取字符串(行表, i) + "\n";
            i = i + 1;
        }
    }
    返回 输出;
}

// ══════════════════════════════════════════════════════════════════
// 找项目根
// ══════════════════════════════════════════════════════════════════

// 从 起始目录 往上找带 qi.toml 的目录，找不到返回 ""。
公开 函数 找项目根(起始目录: 字符串) : 字符串 {
    变量 当前: 字符串 = 路径库.绝对路径(起始目录);
    变量 答案: 字符串 = "";
    变量 层: 整数 = 0;
    当 (层 < 64 && 字符串::字节长度(答案) == 0 && 字符串::字节长度(当前) > 0) {
        如果 (IO.文件存在(当前 + "/qi.toml") == 1) {
            答案 = 当前;
        } 否则 {
            变量 父: 字符串 = 路径库.父目录(当前);
            如果 (字符串::等于(父, 当前) == 1) { 层 = 64; }
            当前 = 父;
        }
        层 = 层 + 1;
    }
    返回 答案;
}

// ══════════════════════════════════════════════════════════════════
// 安装标记 .qi_registry.toml —— 与 Rust 版逐字段一致
// ══════════════════════════════════════════════════════════════════

公开 函数 标记文件名() : 字符串 { 返回 ".qi_registry.toml"; }

公开 函数 有标记(包目录: 字符串) : 整数 {
    返回 IO.文件存在(包目录 + "/" + 标记文件名());
}

公开 函数 标记取值(包目录: 字符串, 键名: 字符串) : 字符串 {
    如果 (有标记(包目录) == 0) { 返回 ""; }
    返回 节内取值(IO.读取文件(包目录 + "/" + 标记文件名()), "", 键名);
}

公开 函数 写标记(包目录: 字符串, 名称: 字符串, 版本: 字符串,
                sha256: 字符串, 来源: 字符串) : 整数 {
    变量 文本: 字符串 = "\"名称\" = \"" + 名称 + "\"\n"
        + "\"版本\" = \"" + 版本 + "\"\n"
        + "sha256 = \"" + sha256 + "\"\n"
        + "\"来源\" = \"" + 来源 + "\"\n";
    IO.写入文件(包目录 + "/" + 标记文件名(), 文本);
    返回 1;
}

// ══════════════════════════════════════════════════════════════════
// qi.lock
// ══════════════════════════════════════════════════════════════════

// 读 qi.lock 里锁定的注册中心包：四元组 名称, 版本, sha256, 来源 依次入表。
// 只挑「来源不是 workspace/path/git+…」且带 sha256 的条目 —— 那些才是注册中心装的。
// lock 不存在 / 解析不动一律返回空表：lock 是**加速与钉死**的手段，不是必需品。
公开 函数 锁定表(项目根: 字符串) : 整数 {
    变量 结果值: 整数 = 表列.创建字符串列表();
    变量 lock路径: 字符串 = 项目根 + "/qi.lock";
    如果 (IO.文件存在(lock路径) == 0) { 返回 结果值; }
    变量 行表: 整数 = 拆行(IO.读取文件(lock路径));
    变量 条数: 整数 = 表列.字符串列表大小(行表);
    变量 在包节: 整数 = 0;
    变量 名称: 字符串 = "";
    变量 版本: 字符串 = "";
    变量 指纹: 字符串 = "";
    变量 来源: 字符串 = "";
    变量 i: 整数 = 0;
    当 (i <= 条数) {
        变量 换节: 整数 = 0;
        变量 一行: 字符串 = "";
        如果 (i < 条数) {
            一行 = 表列.获取字符串(行表, i);
            如果 (字符串::字节长度(节头名(一行)) > 0) { 换节 = 1; }
        } 否则 {
            换节 = 1;
        }
        如果 (换节 == 1) {
            如果 (在包节 == 1) {
                收下锁条目(结果值, 名称, 版本, 指纹, 来源);
            }
            名称 = "";
            版本 = "";
            指纹 = "";
            来源 = "";
            在包节 = 0;
            如果 (i < 条数) {
                变量 头: 字符串 = 节头名(一行);
                如果 (字符串::等于(头, "包") == 1 && 是数组节头(一行) == 1) {
                    在包节 = 1;
                }
            }
        } 否则 {
            如果 (在包节 == 1) {
                变量 键: 字符串 = 行键(一行);
                如果 (字符串::等于(键, "名称") == 1) { 名称 = 行字符串值(一行); }
                如果 (字符串::等于(键, "版本") == 1) { 版本 = 行字符串值(一行); }
                如果 (字符串::等于(键, "sha256") == 1) { 指纹 = 行字符串值(一行); }
                如果 (字符串::等于(键, "来源") == 1) { 来源 = 行字符串值(一行); }
            }
        }
        i = i + 1;
    }
    表列.删除列表(行表);
    返回 结果值;
}

函数 收下锁条目(结果值: 整数, 名称: 字符串, 版本: 字符串, 指纹: 字符串, 来源: 字符串) {
    如果 (字符串::字节长度(名称) > 0 && 字符串::字节长度(版本) > 0
          && 字符串::字节长度(指纹) > 0) {
        如果 (字符串::等于(来源, "workspace") == 0 && 字符串::等于(来源, "path") == 0
              && 字符串::开始于(来源, "git+") == 0) {
            表列.添加字符串(结果值, 名称);
            表列.添加字符串(结果值, 版本);
            表列.添加字符串(结果值, 指纹);
            表列.添加字符串(结果值, 来源);
        }
    }
}

// 在锁定表里查某个包的版本 / sha256（没有返回 ""）
公开 函数 锁定版本(锁表: 整数, 名称: 字符串) : 字符串 {
    返回 锁定字段(锁表, 名称, 1);
}

公开 函数 锁定指纹(锁表: 整数, 名称: 字符串) : 字符串 {
    返回 锁定字段(锁表, 名称, 2);
}

函数 锁定字段(锁表: 整数, 名称: 字符串, 偏移: 整数) : 字符串 {
    变量 条数: 整数 = 表列.字符串列表大小(锁表);
    变量 i: 整数 = 0;
    当 (i + 3 < 条数) {
        如果 (字符串::等于(表列.获取字符串(锁表, i), 名称) == 1) {
            返回 表列.获取字符串(锁表, i + 偏移);
        }
        i = i + 4;
    }
    返回 "";
}

// 写 qi.lock。条目表是五元组：名称, 版本, 来源, 路径, sha256。
// 格式与 Rust 版 toml::to_string_pretty 出来的一致（键带引号），两边混用不打架。
公开 函数 写锁文件(项目根: 字符串, 根名: 字符串, 根版本: 字符串, 条目表: 整数) : 字符串 {
    变量 文本: 字符串 = "\"格式版本\" = 1\n\n[\"根包\"]\n"
        + "\"名称\" = \"" + 根名 + "\"\n";
    如果 (字符串::字节长度(根版本) > 0) {
        文本 = 文本 + "\"版本\" = \"" + 根版本 + "\"\n";
    }
    文本 = 文本 + "\"来源\" = \"workspace\"\n"
        + "\"路径\" = \"" + 项目根 + "\"\n";
    变量 条数: 整数 = 表列.字符串列表大小(条目表);
    变量 i: 整数 = 0;
    当 (i + 4 < 条数) {
        文本 = 文本 + "\n[[\"包\"]]\n"
            + "\"名称\" = \"" + 表列.获取字符串(条目表, i) + "\"\n";
        如果 (字符串::字节长度(表列.获取字符串(条目表, i + 1)) > 0) {
            文本 = 文本 + "\"版本\" = \"" + 表列.获取字符串(条目表, i + 1) + "\"\n";
        }
        文本 = 文本 + "\"来源\" = \"" + 表列.获取字符串(条目表, i + 2) + "\"\n"
            + "\"路径\" = \"" + 表列.获取字符串(条目表, i + 3) + "\"\n"
            + "sha256 = \"" + 表列.获取字符串(条目表, i + 4) + "\"\n";
        i = i + 5;
    }
    变量 lock路径: 字符串 = 项目根 + "/qi.lock";
    IO.写入文件(lock路径, 文本);
    返回 lock路径;
}
