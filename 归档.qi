// qi-pkg · 归档 —— tar 读写（纯 qi 实现）+ gzip 收尾
//
// 一个包版本 = 一个 tar.gz：包根的 qi.toml + 全部源码，tar 内路径都是**相对包根**
// 的（没有 `包名-版本/` 顶层目录），解包时直接铺进 `qi_packages/<名称>/`。
//
// ── 为什么要自己写 tar ────────────────────────────────────────────
//
// 标准库有 gzip（压缩字节 / 解压字节，二进制安全走字节切片句柄），**没有 tar**。
// tar 本身是最不需要库的格式：512 字节定长头 + 512 对齐的数据块 + 两个全零块收尾，
// 头里只有名字、八进制数字和一个校验和。两百行 qi 就够，还不用引第二个依赖。
//
// ── 与 Rust 版（qi/src/package/archive.rs）的兼容 ──────────────────
//
// 头按 **GNU tar** 排（magic "ustar ", version " \0"），跟 Rust 那边
// `tar::Header::new_gnu()` 一致；mtime/uid/gid 一律 0，文件按路径排序，
// 所以同样的目录内容打两次字节一致 —— sha256 才有意义。
//
// 路径超过 99 字节走 GNU 长名扩展（typeflag 'L' + "././@LongLink" 条目），
// 与 Rust 的 tar crate 同一套。中文文件名在这个仓里遍地都是，一个中文字 3 字节，
// 33 个字就撞线，不能只支持 ustar 短名。
//
// **一处刻意的差异**：Rust 版会把可执行文件的 mode 写成 0755，qi 这边没有
// 「读文件权限位」的原语，一律写 0644。所以两边打出的字节可能差几个位，
// sha256 不同 —— 但解出来的文件内容逐字节一致，互相都装得下。

包 Pkg;

导入 标准库.字节切片 作为 字节库;
导入 标准库.压缩 作为 压缩库;
导入 标准库.字符串;
导入 标准库.列表 作为 表列;
导入 标准库.操作系统 作为 系统;
导入 标准库.路径 作为 路径库;
导入 标准库.输入输出 作为 IO;

// ══════════════════════════════════════════════════════════════════
// 排除规则（与 Rust 版 archive.rs 的三张表逐条对齐）
// ══════════════════════════════════════════════════════════════════

// 任意层级命中即整棵剪掉。tests/ 在列表里是**发布减肥**：测试只对开发者有意义。
// 必须与 qi/src/package/archive.rs 的 排除目录 **逐项一致** ——
// 两个打包器打出的 tar.gz 是逐字节比对过的，差一项 sha256 就对不上。
公开 函数 排除目录表() : 字符串 {
    返回 ".git\ntarget\ntarget-wt\nqi_packages\ntests\nnode_modules\n.venv\n__pycache__";
}

// .qi_registry.toml / .qi_source.toml 是**本机安装记录**，不是包内容 ——
// 不排掉的话，装好的包再打一次得到的字节跟发布时不一样，sha256 对不上。
公开 函数 排除文件表() : 字符串 {
    返回 ".DS_Store\n.qi_registry.toml\n.qi_source.toml\nqi.lock";
}

函数 表里有(表文本: 字符串, 名: 字符串) : 整数 {
    变量 位置: 整数 = 0;
    变量 总长: 整数 = 字符串::字节长度(表文本);
    当 (位置 <= 总长) {
        变量 行尾: 整数 = 位置;
        当 (行尾 < 总长 && 字符串::等于(字符串::子串(表文本, 行尾, 1), "\n") == 0) {
            行尾 = 行尾 + 1;
        }
        如果 (字符串::等于(字符串::子串(表文本, 位置, 行尾 - 位置), 名) == 1) {
            返回 1;
        }
        位置 = 行尾 + 1;
    }
    返回 0;
}

// 判断一个**相对包根**的路径是否该被排除。
公开 函数 应排除(相对路径: 字符串) : 整数 {
    变量 总长: 整数 = 字符串::字节长度(相对路径);
    如果 (总长 == 0) { 返回 1; }
    变量 段起: 整数 = 0;
    变量 最后一段: 字符串 = "";
    当 (段起 <= 总长) {
        变量 段尾: 整数 = 段起;
        当 (段尾 < 总长 && 字符串::等于(字符串::子串(相对路径, 段尾, 1), "/") == 0) {
            段尾 = 段尾 + 1;
        }
        变量 一段: 字符串 = 字符串::子串(相对路径, 段起, 段尾 - 段起);
        // 空段 / . / .. 一律不收，防止打出越界的 tar
        如果 (字符串::字节长度(一段) == 0) { 返回 1; }
        如果 (字符串::等于(一段, ".") == 1) { 返回 1; }
        如果 (字符串::等于(一段, "..") == 1) { 返回 1; }
        如果 (表里有(排除目录表(), 一段) == 1) { 返回 1; }
        最后一段 = 一段;
        段起 = 段尾 + 1;
    }
    如果 (表里有(排除文件表(), 最后一段) == 1) { 返回 1; }
    如果 (字符串::结束于(最后一段, ".o") == 1) { 返回 1; }
    返回 0;
}

// ══════════════════════════════════════════════════════════════════
// tar 写
// ══════════════════════════════════════════════════════════════════

// 零填充的八进制，位数固定。tar 的数字字段全是这个形状。
公开 函数 八进制(值: 整数, 位数: 整数) : 字符串 {
    变量 输出: 字符串 = "";
    变量 剩: 整数 = 值;
    变量 i: 整数 = 0;
    当 (i < 位数) {
        输出 = 字符串::子串("01234567", 剩 % 8, 1) + 输出;
        剩 = 剩 / 8;
        i = i + 1;
    }
    返回 输出;
}

函数 写文本(输出: 整数, 位置: 整数, 文本: 字符串) {
    变量 源: 整数 = 字节库.从字符串(文本);
    写切片(输出, 位置, 源, 字节库.长度(源));
    字节库.释放切片(源);
}

函数 写切片(输出: 整数, 位置: 整数, 源: 整数, 长度: 整数) {
    变量 i: 整数 = 0;
    当 (i < 长度) {
        字节库.设置(输出, 位置 + i, 字节库.获取(源, i));
        i = i + 1;
    }
}

// 校验和：把 148..156 当成 8 个空格算整个头的字节和，再写回 148..155。
//
// 写成「7 位零填充八进制 + NUL」而不是老式的「6 位 + NUL + 空格」，是为了跟
// Rust 的 tar crate 逐字节对齐（它的 octal_into 填满整个字段只留最后一字节）。
// 两种写法所有 tar 读端都认，但对齐了才好拿 sha256 直接对拍两边的产物。
函数 补校验和(输出: 整数, 头起点: 整数) {
    变量 i: 整数 = 0;
    当 (i < 8) {
        字节库.设置(输出, 头起点 + 148 + i, 32);
        i = i + 1;
    }
    变量 和: 整数 = 0;
    i = 0;
    当 (i < 512) {
        和 = 和 + 字节库.获取(输出, 头起点 + i);
        i = i + 1;
    }
    写文本(输出, 头起点 + 148, 八进制(和, 7));
    字节库.设置(输出, 头起点 + 155, 0);
}

// 追加一个 512 字节的 GNU tar 头。名字用**字节切片**传（不是字符串）——
// 长名截断时要按字节切，中文正好会被切在半个字上，走字符串就没法表达。
函数 写一个头(输出: 整数, 名切片: 整数, 名长: 整数, 大小: 整数, 类型标记: 整数,
              权限: 整数) {
    变量 头起点: 整数 = 字节库.长度(输出);
    变量 i: 整数 = 0;
    当 (i < 512) {
        字节库.追加字节(输出, 0);
        i = i + 1;
    }
    写切片(输出, 头起点, 名切片, 名长);
    写文本(输出, 头起点 + 100, 八进制(权限, 7));     // mode
    写文本(输出, 头起点 + 108, 八进制(0, 7));        // uid
    写文本(输出, 头起点 + 116, 八进制(0, 7));        // gid
    写文本(输出, 头起点 + 124, 八进制(大小, 11));    // size
    写文本(输出, 头起点 + 136, 八进制(0, 11));       // mtime
    字节库.设置(输出, 头起点 + 156, 类型标记);
    写文本(输出, 头起点 + 257, "ustar ");            // GNU magic
    字节库.设置(输出, 头起点 + 263, 32);             // version " \0"
    字节库.设置(输出, 头起点 + 264, 0);
    补校验和(输出, 头起点);
}

// 数据块：内容原样追加，再补零到 512 的整数倍。
函数 写数据块(输出: 整数, 内容: 整数) {
    字节库.追加切片(输出, 内容);
    变量 余: 整数 = 字节库.长度(输出) % 512;
    如果 (余 > 0) {
        变量 i: 整数 = 余;
        当 (i < 512) {
            字节库.追加字节(输出, 0);
            i = i + 1;
        }
    }
}

// tar 头里的 mode。qi **没有**「读文件权限位」的原语，所以只能猜：
// 以 `#!` 开头的当脚本写 0755，其余一律 0644。
//
// 这是个坦白的近似，不是真相。它存在的唯一理由是让 qipkg 打出来的字节能跟
// Rust 版（真去读了权限位）逐字节对上 —— 仓库里可执行的东西基本都是带 shebang
// 的脚本。猜错的后果很小：两边的 解包 都用 fs::write 落地，本来就不还原权限位，
// 只有拿 GNU tar -x 解的人会看出差别。运行时哪天补上「取文件权限」，这里换成真读。
函数 文件权限(内容: 整数) : 整数 {
    如果 (字节库.长度(内容) >= 2 && 字节库.获取(内容, 0) == 35
          && 字节库.获取(内容, 1) == 33) {
        返回 493;      // 0o755
    }
    返回 420;          // 0o644
}

// 往 tar 里加一个普通文件条目。路径 >= 100 字节走 GNU 长名。
公开 函数 追加条目(输出: 整数, 相对路径: 字符串, 内容: 整数) {
    变量 名切片: 整数 = 字节库.从字符串(相对路径);
    变量 名长: 整数 = 字节库.长度(名切片);
    如果 (名长 >= 100) {
        变量 长名体: 整数 = 字节库.创建();
        字节库.追加切片(长名体, 名切片);
        字节库.追加字节(长名体, 0);
        变量 标记名: 整数 = 字节库.从字符串("././@LongLink");
        写一个头(输出, 标记名, 字节库.长度(标记名), 名长 + 1, 76, 420);
        写数据块(输出, 长名体);
        字节库.释放切片(标记名);
        字节库.释放切片(长名体);
        // 短头里放截断后的前 100 字节（GNU tar 的老规矩，解包方以长名为准）
        变量 截断: 整数 = 字节库.切片(名切片, 0, 100);
        字节库.释放切片(名切片);
        名切片 = 截断;
        名长 = 100;
    }
    写一个头(输出, 名切片, 名长, 字节库.长度(内容), 48, 文件权限(内容));
    写数据块(输出, 内容);
    字节库.释放切片(名切片);
}

// 收尾：两个全零块。
公开 函数 收尾(输出: 整数) {
    变量 i: 整数 = 0;
    当 (i < 1024) {
        字节库.追加字节(输出, 0);
        i = i + 1;
    }
}

// ══════════════════════════════════════════════════════════════════
// 目录遍历与排序
// ══════════════════════════════════════════════════════════════════


函数 走一层(根规范: 字符串, 相对前缀: 字符串, 结果值: 整数, 深度: 整数) {
    如果 (深度 > 32) { 返回; }
    变量 绝对目录: 字符串 = 根规范;
    如果 (字符串::字节长度(相对前缀) > 0) {
        绝对目录 = 根规范 + "/" + 相对前缀;
    }
    // 列出目录 直接给列表句柄（2.0 起），不用再 按行拆
    变量 名表: 整数 = 系统.列出目录(绝对目录);
    如果 (名表 < 0) { 返回; }
    变量 个数: 整数 = 表列.字符串列表大小(名表);
    变量 i: 整数 = 0;
    当 (i < 个数) {
        变量 名: 字符串 = 表列.获取字符串(名表, i);
        变量 相对: 字符串 = 名;
        如果 (字符串::字节长度(相对前缀) > 0) {
            相对 = 相对前缀 + "/" + 名;
        }
        如果 (应排除(相对) == 0 && 是符号链接(根规范, 相对) == 0) {
            如果 (系统.是否为目录(根规范 + "/" + 相对) == 1) {
                走一层(根规范, 相对, 结果值, 深度 + 1);
            } 否则 {
                表列.添加字符串(结果值, 相对);
            }
        }
        i = i + 1;
    }
    表列.删除列表(名表);
}

// 符号链接一律不打进包 —— 跟 Rust 版 walkdir(follow_links=false) 只收 is_file()
// 的行为一致。qi 没有 lstat，用「规范化后还是不是原路径」来认：根已经规范化过，
// 所以只要路径里有一节是软链，canonicalize 出来就跟拼出来的不一样。
//
// 不这么判会出事：qi-harness 里有个 .qibin/qi 软链指着 50 MB 的编译器二进制，
// 跟着链接读就把编译器打进包了（实测 412 KB → 58 MB）。
函数 是符号链接(根规范: 字符串, 相对: 字符串) : 整数 {
    变量 拼出来的: 字符串 = 根规范 + "/" + 相对;
    如果 (字符串::等于(路径库.绝对路径(拼出来的), 拼出来的) == 1) { 返回 0; }
    返回 1;
}

// 路径序（不是字节序）：按 '/' 分段逐段比。把 '/' 当成 0x00 参与字节比较
// 就等价于分段比 —— 分隔符比任何真实字节都小，短的前缀自然排前面。
// 这跟 Rust 那边 BTreeSet<PathBuf> 的顺序一致，所以两边打出的条目顺序相同。
公开 函数 路径序比较(甲: 字符串, 乙: 字符串) : 整数 {
    变量 a: 整数 = 字节库.从字符串(甲);
    变量 b: 整数 = 字节库.从字符串(乙);
    变量 na: 整数 = 字节库.长度(a);
    变量 nb: 整数 = 字节库.长度(b);
    变量 上限: 整数 = na;
    如果 (nb < 上限) { 上限 = nb; }
    变量 结论: 整数 = 0;
    变量 i: 整数 = 0;
    当 (i < 上限 && 结论 == 0) {
        变量 x: 整数 = 字节库.获取(a, i);
        变量 y: 整数 = 字节库.获取(b, i);
        如果 (x == 47) { x = 0; }
        如果 (y == 47) { y = 0; }
        如果 (x < y) { 结论 = -1; }
        如果 (x > y) { 结论 = 1; }
        i = i + 1;
    }
    如果 (结论 == 0) {
        如果 (na < nb) { 结论 = -1; }
        如果 (na > nb) { 结论 = 1; }
    }
    字节库.释放切片(a);
    字节库.释放切片(b);
    返回 结论;
}

// 选择排序出一份新表（列表原语没有「设置字符串」，原地排不了）。
// 一个包几十上百个文件，n² 完全够用。
函数 排好序(原表: 整数) : 整数 {
    变量 个数: 整数 = 表列.字符串列表大小(原表);
    变量 用过: 整数 = 表列.创建整数列表();
    变量 i: 整数 = 0;
    当 (i < 个数) {
        表列.添加整数(用过, 0);
        i = i + 1;
    }
    变量 结果值: 整数 = 表列.创建字符串列表();
    变量 轮: 整数 = 0;
    当 (轮 < 个数) {
        变量 最小位: 整数 = -1;
        变量 j: 整数 = 0;
        当 (j < 个数) {
            如果 (表列.获取整数(用过, j) == 0) {
                如果 (最小位 < 0) {
                    最小位 = j;
                } 否则 {
                    如果 (路径序比较(表列.获取字符串(原表, j),
                                    表列.获取字符串(原表, 最小位)) < 0) {
                        最小位 = j;
                    }
                }
            }
            j = j + 1;
        }
        表列.设置整数(用过, 最小位, 1);
        表列.添加字符串(结果值, 表列.获取字符串(原表, 最小位));
        轮 = 轮 + 1;
    }
    表列.删除列表(用过);
    返回 结果值;
}

// 包根下所有该打包的文件（相对路径，已按路径序排好）。调用方负责 删除列表。
公开 函数 收集文件(包根: 字符串) : 整数 {
    变量 生表: 整数 = 表列.创建字符串列表();
    走一层(路径库.绝对路径(包根), "", 生表, 0);
    变量 熟表: 整数 = 排好序(生表);
    表列.删除列表(生表);
    返回 熟表;
}

// ══════════════════════════════════════════════════════════════════
// 打包
// ══════════════════════════════════════════════════════════════════

// 把 包根 目录打成未压缩 tar 字节切片。空目录返回 -1。
公开 函数 打成tar(包根: 字符串) : 整数 {
    如果 (系统.是否为目录(包根) == 0) { 返回 -1; }
    变量 根规范: 字符串 = 路径库.绝对路径(包根);
    变量 文件表: 整数 = 收集文件(根规范);
    变量 个数: 整数 = 表列.字符串列表大小(文件表);
    如果 (个数 == 0) {
        表列.删除列表(文件表);
        返回 -1;
    }
    变量 输出: 整数 = 字节库.创建();
    变量 i: 整数 = 0;
    当 (i < 个数) {
        变量 相对: 字符串 = 表列.获取字符串(文件表, i);
        变量 内容: 整数 = 字节库.读取文件(根规范 + "/" + 相对);
        如果 (内容 >= 0) {
            追加条目(输出, 相对, 内容);
            字节库.释放切片(内容);
        }
        i = i + 1;
    }
    表列.删除列表(文件表);
    收尾(输出);
    返回 输出;
}

// 打成 tar.gz。返回新切片句柄，调用方负责释放；失败返回 -1。
公开 函数 打包(包根: 字符串) : 整数 {
    变量 tar切片: 整数 = 打成tar(包根);
    如果 (tar切片 < 0) { 返回 -1; }
    变量 压好: 整数 = 压缩库.压缩字节(tar切片);
    字节库.释放切片(tar切片);
    返回 压好;
}

// ══════════════════════════════════════════════════════════════════
// tar 读
// ══════════════════════════════════════════════════════════════════

// 头里的名字：0..100，NUL 截断。中文名走 UTF-8，所以必须切片再转字符串，
// 不能一个字节一个字节地拼。
公开 函数 头里取名(tar切片: 整数, 头起点: 整数) : 字符串 {
    变量 长度: 整数 = 0;
    当 (长度 < 100 && 字节库.获取(tar切片, 头起点 + 长度) > 0) {
        长度 = 长度 + 1;
    }
    如果 (长度 == 0) { 返回 ""; }
    变量 片: 整数 = 字节库.切片(tar切片, 头起点, 长度);
    变量 名: 字符串 = 字节库.转字符串(片);
    字节库.释放切片(片);
    返回 名;
}

// 八进制数字字段（大小 / mtime / mode …）。非八进制字符一律跳过。
公开 函数 头里取八进制(tar切片: 整数, 头起点: 整数, 偏移: 整数, 宽度: 整数) : 整数 {
    变量 值: 整数 = 0;
    变量 i: 整数 = 0;
    当 (i < 宽度) {
        变量 一字节: 整数 = 字节库.获取(tar切片, 头起点 + 偏移 + i);
        如果 (一字节 >= 48 && 一字节 <= 55) {
            值 = 值 * 8 + (一字节 - 48);
        }
        i = i + 1;
    }
    返回 值;
}

公开 函数 头里取大小(tar切片: 整数, 头起点: 整数) : 整数 {
    返回 头里取八进制(tar切片, 头起点, 124, 12);
}

// 头自带的校验和对不对。坏头意味着后面的偏移全是错的，宁可当场停。
公开 函数 头校验和对(tar切片: 整数, 头起点: 整数) : 整数 {
    变量 记的: 整数 = 头里取八进制(tar切片, 头起点, 148, 8);
    变量 和: 整数 = 0;
    变量 i: 整数 = 0;
    当 (i < 512) {
        变量 一字节: 整数 = 字节库.获取(tar切片, 头起点 + i);
        如果 (i >= 148 && i < 156) { 一字节 = 32; }
        和 = 和 + 一字节;
        i = i + 1;
    }
    如果 (和 == 记的) { 返回 1; }
    返回 0;
}

// 路径安全：注册中心不是可信输入，一个 `../../.ssh/authorized_keys` 条目
// 就能写出安装目录之外。判定不问宿主系统，只看路径长什么样 ——
// 同一个包在 Linux 上装得下、在 Windows 上逃逸是最难查的一类。
公开 函数 路径越界(路径: 字符串) : 整数 {
    变量 总长: 整数 = 字符串::字节长度(路径);
    如果 (总长 == 0) { 返回 1; }
    如果 (字符串::开始于(路径, "/") == 1) { 返回 1; }
    // 反斜杠在 Linux 上是普通文件名，到 Windows 就是目录分隔符 —— 两边都拒
    如果 (字符串::包含(路径, "\\") == 1) { 返回 1; }
    变量 段起: 整数 = 0;
    当 (段起 <= 总长) {
        变量 段尾: 整数 = 段起;
        当 (段尾 < 总长 && 字符串::等于(字符串::子串(路径, 段尾, 1), "/") == 0) {
            段尾 = 段尾 + 1;
        }
        变量 一段: 字符串 = 字符串::子串(路径, 段起, 段尾 - 段起);
        如果 (字符串::等于(一段, "..") == 1) { 返回 1; }
        // `C:/x` 在 Unix 上只是个叫 "C:" 的目录名，到 Windows 才变盘符。按形状认。
        如果 (字符串::字节长度(一段) >= 2
              && 字符串::等于(字符串::子串(一段, 1, 1), ":") == 1) { 返回 1; }
        段起 = 段尾 + 1;
    }
    返回 0;
}

// 目标路径的父目录（相对路径里最后一个 '/' 之前的部分），没有则返回 ""。
函数 父段(路径: 字符串) : 字符串 {
    变量 总长: 整数 = 字符串::字节长度(路径);
    变量 最后: 整数 = -1;
    变量 i: 整数 = 0;
    当 (i < 总长) {
        如果 (字符串::等于(字符串::子串(路径, i, 1), "/") == 1) { 最后 = i; }
        i = i + 1;
    }
    如果 (最后 < 0) { 返回 ""; }
    返回 字符串::子串(路径, 0, 最后);
}

// 解 tar 到目标目录。返回落地文件数；越界路径 / 坏头一律返回 -1。
公开 函数 解tar(tar切片: 整数, 目标目录: 字符串) : 整数 {
    IO.创建目录(目标目录);
    变量 总长: 整数 = 字节库.长度(tar切片);
    变量 计数: 整数 = 0;
    变量 头起点: 整数 = 0;
    变量 长名: 字符串 = "";
    变量 出错: 整数 = 0;
    当 (头起点 + 512 <= 总长 && 出错 == 0) {
        如果 (字节库.获取(tar切片, 头起点) == 0) {
            头起点 = 总长;          // 全零块 = 归档结束
        } 否则 {
            如果 (头校验和对(tar切片, 头起点) == 0) {
                出错 = 1;
            } 否则 {
                变量 条目名: 字符串 = 头里取名(tar切片, 头起点);
                如果 (字符串::字节长度(长名) > 0) {
                    条目名 = 长名;
                    长名 = "";
                }
                变量 条目大小: 整数 = 头里取大小(tar切片, 头起点);
                变量 类型标记: 整数 = 字节库.获取(tar切片, 头起点 + 156);
                变量 数据起点: 整数 = 头起点 + 512;
                变量 下一头: 整数 = 数据起点 + ((条目大小 + 511) / 512) * 512;
                如果 (数据起点 + 条目大小 > 总长) {
                    出错 = 1;
                } 否则 {
                    如果 (类型标记 == 76) {
                        // GNU 长名条目：内容就是下一条的真实路径（末尾一个 NUL）
                        变量 名片: 整数 = 字节库.切片(tar切片, 数据起点, 条目大小 - 1);
                        长名 = 字节库.转字符串(名片);
                        字节库.释放切片(名片);
                    } 否则 {
                        如果 (类型标记 == 48 || 类型标记 == 0) {
                            如果 (路径越界(条目名) == 1) {
                                出错 = 1;
                            } 否则 {
                                变量 父: 字符串 = 父段(条目名);
                                如果 (字符串::字节长度(父) > 0) {
                                    IO.创建目录(目标目录 + "/" + 父);
                                }
                                变量 内容: 整数 = 字节库.切片(tar切片, 数据起点, 条目大小);
                                字节库.写入文件(内容, 目标目录 + "/" + 条目名);
                                字节库.释放切片(内容);
                                计数 = 计数 + 1;
                            }
                        }
                    }
                    头起点 = 下一头;
                }
            }
        }
    }
    如果 (出错 == 1) { 返回 -1; }
    返回 计数;
}

// 解 tar.gz 到目标目录。
公开 函数 解包(压缩切片: 整数, 目标目录: 字符串) : 整数 {
    变量 tar切片: 整数 = 压缩库.解压字节(压缩切片);
    如果 (tar切片 < 0) { 返回 -1; }
    变量 计数: 整数 = 解tar(tar切片, 目标目录);
    字节库.释放切片(tar切片);
    返回 计数;
}

// gzip 魔数 1f 8b —— 拿到的东西根本不是 tar.gz 时早点说人话。
公开 函数 像gzip(切片: 整数) : 整数 {
    如果 (字节库.长度(切片) < 18) { 返回 0; }
    如果 (字节库.获取(切片, 0) != 31) { 返回 0; }
    如果 (字节库.获取(切片, 1) != 139) { 返回 0; }
    返回 1;
}

// 从 tar.gz 里只把包根 qi.toml 抠出来（发布前自检 名称/版本 用）。找不到返回 ""。
公开 函数 读包内清单(压缩切片: 整数) : 字符串 {
    变量 tar切片: 整数 = 压缩库.解压字节(压缩切片);
    如果 (tar切片 < 0) { 返回 ""; }
    变量 总长: 整数 = 字节库.长度(tar切片);
    变量 清单: 字符串 = "";
    变量 头起点: 整数 = 0;
    变量 长名: 字符串 = "";
    当 (头起点 + 512 <= 总长) {
        如果 (字节库.获取(tar切片, 头起点) == 0) {
            头起点 = 总长;
        } 否则 {
            变量 条目名: 字符串 = 头里取名(tar切片, 头起点);
            如果 (字符串::字节长度(长名) > 0) {
                条目名 = 长名;
                长名 = "";
            }
            变量 条目大小: 整数 = 头里取大小(tar切片, 头起点);
            变量 类型标记: 整数 = 字节库.获取(tar切片, 头起点 + 156);
            变量 数据起点: 整数 = 头起点 + 512;
            如果 (类型标记 == 76 && 数据起点 + 条目大小 <= 总长) {
                变量 名片: 整数 = 字节库.切片(tar切片, 数据起点, 条目大小 - 1);
                长名 = 字节库.转字符串(名片);
                字节库.释放切片(名片);
            }
            如果 (是包根清单(条目名) == 1 && (类型标记 == 48 || 类型标记 == 0)
                  && 数据起点 + 条目大小 <= 总长) {
                变量 内容片: 整数 = 字节库.切片(tar切片, 数据起点, 条目大小);
                清单 = 字节库.转字符串(内容片);
                字节库.释放切片(内容片);
                头起点 = 总长;
            } 否则 {
                头起点 = 数据起点 + ((条目大小 + 511) / 512) * 512;
            }
        }
    }
    字节库.释放切片(tar切片);
    返回 清单;
}

// 是不是「包根的 qi.toml」？允许 qi.toml、./qi.toml、包名/qi.toml 三种写法。
公开 函数 是包根清单(条目名: 字符串) : 整数 {
    变量 名字: 字符串 = 条目名;
    如果 (字符串::开始于(名字, "./") == 1) {
        名字 = 字符串::子串从位置(名字, 2);
    }
    如果 (字符串::等于(名字, "qi.toml") == 1) { 返回 1; }
    如果 (字符串::结束于(名字, "/qi.toml") == 0) { 返回 0; }
    变量 斜杠数: 整数 = 0;
    变量 位置: 整数 = 0;
    变量 总长: 整数 = 字符串::字节长度(名字);
    当 (位置 < 总长) {
        如果 (字符串::等于(字符串::子串(名字, 位置, 1), "/") == 1) {
            斜杠数 = 斜杠数 + 1;
        }
        位置 = 位置 + 1;
    }
    如果 (斜杠数 == 1) { 返回 1; }
    返回 0;
}
