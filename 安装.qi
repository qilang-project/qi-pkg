// qi-pkg · 安装 —— 下载 → 校验 sha256 → 落地 → 接着装它自己的依赖
//
// 落地位置：顶层依赖进 `<项目>/qi_packages/<别名>`，某个包的依赖进
// `<那个包>/qi_packages/<别名>` —— **嵌套，不是平铺**。编译期解析器只认
// 包自己目录下的 qi_packages，平铺过一次不行。
//
// 每个装好的包根写一个 .qi_registry.toml，记 名称/版本/sha256/来源。有它才能：
//   幂等   —— 再装一次先比对标记，一致就跳过，不白下一遍
//   写 lock —— lock 的 sha256 从这里读，不用重新算包体
//
// qi.lock 只钉顶层。深层包的完整性靠注册中心元数据里的 sha256 逐个校验
// （安装一个包 内部一定会比对），所以不锁也不会装到被换掉的包体。

包 Pkg;

导入 标准库.字符串;
导入 标准库.字节切片 作为 字节库;
导入 标准库.列表 作为 表列;
导入 标准库.操作系统 作为 系统;
导入 标准库.输入输出 作为 IO;
导入 标准库.路径 作为 路径库;

// 依赖树的最大层数。真实依赖链两三层就到头，超过多半是清单写错或环没断干净，
// 与其一路装到磁盘满，不如在这里停住报清楚。
常量 依赖最大层数 = 16;

变量 上次安装错: 字符串 = "";
变量 计_装了: 整数 = 0;
变量 计_跳过: 整数 = 0;
变量 详细模式: 整数 = 0;

公开 函数 安装错() : 字符串 { 返回 上次安装错; }
公开 函数 装了几个() : 整数 { 返回 计_装了; }
公开 函数 跳过几个() : 整数 { 返回 计_跳过; }
公开 函数 设详细(开: 整数) { 详细模式 = 开; }

// 安装一个注册中心包到 包目录（幂等）。
// 返回 0 = 已是最新跳过；> 0 = 本次真装了（值是文件数）；-1 = 失败（原因看 安装错()）。
//
// 锁定指纹 来自 qi.lock：给了就以它为准 —— lock 的意义就是把版本内容钉死，
// 注册中心事后改了同版本号的包体（协议禁止但要防），或者 lock 被人改坏，
// 都必须当场停下来而不是默默装个别的东西。
公开 函数 安装一个包(名称: 字符串, 版本: 字符串, 包目录: 字符串,
                    锁定指纹: 字符串) : 整数 {
    上次安装错 = "";

    // ── 幂等短路：目录在、标记在、版本对、sha256 对上就直接跳过 ──
    如果 (有标记(包目录) == 1) {
        变量 已装版本: 字符串 = 标记取值(包目录, "版本");
        变量 已装指纹: 字符串 = 标记取值(包目录, "sha256");
        变量 期望: 字符串 = 锁定指纹;
        如果 (字符串::字节长度(期望) == 0) { 期望 = 已装指纹; }
        如果 (字符串::等于(已装版本, 版本) == 1 && 字符串::等于(已装指纹, 期望) == 1
              && IO.文件存在(包目录 + "/qi.toml") == 1) {
            返回 0;
        }
    }

    // ── 先问元数据：拿权威 sha256，顺便把「没这个版本」跟「服务挂了」分开 ──
    变量 权威指纹: 字符串 = 取版本指纹(名称, 版本);
    如果 (字符串::字节长度(权威指纹) == 0) {
        如果 (状态码() == 404) {
            上次安装错 = "注册中心 " + 地址() + " 上没有 " + 名称 + " 的 " + 版本
                + " 版本\n  用 `qipkg 搜索 " + 名称 + "` 看看有哪些包，或确认版本号";
        } 否则 {
            如果 (字符串::字节长度(网络错()) > 0) {
                上次安装错 = 网络错();
            } 否则 {
                上次安装错 = "注册中心 " + 地址() + " 返回的 " + 名称 + " " + 版本
                    + " 版本元数据里没有 sha256，无法校验完整性，拒绝安装（HTTP "
                    + 状态码() + "：" + 错误原因() + "）";
            }
        }
        返回 -1;
    }

    // lock 钉死的与注册中心当前给的不一致 —— 不下载就先停
    如果 (字符串::字节长度(锁定指纹) > 0 && 字符串::等于(锁定指纹, 权威指纹) == 0) {
        上次安装错 = "qi.lock 锁定的 " + 名称 + " " + 版本 + " 与注册中心当前的对不上，拒绝安装：\n"
            + "  qi.lock : " + 锁定指纹 + "\n"
            + "  注册中心: " + 权威指纹 + "\n"
            + "  版本内容一旦发布就不可变。要么 lock 被改过，要么注册中心换掉了同版本的包体。";
        返回 -1;
    }

    // ── 下载 ──
    变量 临时包: 字符串 = 系统.临时目录() + "/qipkg-" + 系统.进程ID() + ".tar.gz";
    变量 字节数: 整数 = 下载到文件(名称, 版本, 临时包);
    如果 (字节数 < 0) {
        上次安装错 = "下载 " + 名称 + " " + 版本 + " 失败（错误码 " + 字节数
            + "）\n  检查网络，或用环境变量 QI_REGISTRY 指向可达的注册中心";
        返回 -1;
    }
    变量 包体: 整数 = 字节库.读取文件(临时包);
    IO.删除文件(临时包);
    如果 (包体 < 0) {
        上次安装错 = "下载下来的包体读不回来：" + 临时包;
        返回 -1;
    }

    变量 实际指纹: 字符串 = SHA256十六进制(包体);
    如果 (字符串::等于(实际指纹, 权威指纹) == 0) {
        字节库.释放切片(包体);
        上次安装错 = 名称 + " " + 版本 + " 下载内容校验失败，已丢弃：\n"
            + "  期望 sha256: " + 权威指纹 + "\n"
            + "  实际 sha256: " + 实际指纹 + "\n"
            + "  可能是传输损坏或注册中心数据不一致，重试一次；仍不符请报给注册中心维护者。";
        返回 -1;
    }
    如果 (像gzip(包体) == 0) {
        字节库.释放切片(包体);
        上次安装错 = 名称 + " " + 版本 + " 的包体不是 gzip（前两个字节不是 1f 8b）";
        返回 -1;
    }

    // ── 校验通过才动磁盘。先解到同级临时目录，成功后整体替换 ──
    // 直接往包目录里解会有半成品风险：解一半失败就留下个「看起来装好了、其实缺文件」
    // 的目录，编译先炸。
    变量 父目录: 字符串 = 路径库.父目录(包目录);
    变量 目录名: 字符串 = 路径库.文件名(包目录);
    IO.创建目录(父目录);
    变量 临时目录: 字符串 = 父目录 + "/." + 目录名 + ".tmp" + 系统.进程ID();
    IO.删除目录(临时目录);

    变量 文件数: 整数 = 解包(包体, 临时目录);
    字节库.释放切片(包体);
    如果 (文件数 <= 0) {
        IO.删除目录(临时目录);
        上次安装错 = 名称 + " " + 版本 + " 的包体解不开（不是合法的 tar.gz，或含越界路径）";
        返回 -1;
    }
    如果 (IO.文件存在(临时目录 + "/qi.toml") == 0) {
        IO.删除目录(临时目录);
        上次安装错 = 名称 + " " + 版本 + " 的包体里没有包根 qi.toml，不是合法的 qi 包";
        返回 -1;
    }
    写标记(临时目录, 名称, 版本, 权威指纹, 地址());

    // 内容对不上就是要**整体换掉**，不能只覆盖同名文件：旧版本多出来的文件
    // 留在那里，编译器的模块扫描照样能看见，会撞出莫名其妙的重复符号。
    IO.删除目录(包目录);
    IO.重命名(临时目录, 包目录);
    如果 (IO.文件存在(包目录 + "/qi.toml") == 0) {
        上次安装错 = "移动安装目录失败 " + 临时目录 + " -> " + 包目录;
        返回 -1;
    }
    返回 文件数;
}

// ══════════════════════════════════════════════════════════════════
// 传递依赖
// ══════════════════════════════════════════════════════════════════

函数 缩进(深度: 整数) : 字符串 {
    变量 输出: 字符串 = "";
    变量 i: 整数 = 0;
    当 (i < 深度) {
        输出 = 输出 + "  ";
        i = i + 1;
    }
    返回 输出;
}

函数 表里含(表: 整数, 值: 字符串) : 整数 {
    变量 条数: 整数 = 表列.字符串列表大小(表);
    变量 i: 整数 = 0;
    当 (i < 条数) {
        如果 (字符串::等于(表列.获取字符串(表, i), 值) == 1) { 返回 1; }
        i = i + 1;
    }
    返回 0;
}

// 装一层依赖，装完每个包再进它自己的 qi.toml 接着装 —— 传递依赖。
// 依赖表是交替的 别名, 版本；锁表来自 清单.锁定表（只在深度 0 生效）。
// 返回 1 成功，0 失败（原因看 安装错()）。
公开 函数 装一层(依赖表: 整数, 父目录: 字符串, 锁表: 整数, 深度: 整数, 已见: 整数) : 整数 {
    如果 (深度 > 依赖最大层数) {
        上次安装错 = "依赖层数超过 " + 依赖最大层数 + "，可能是清单里有环。停在 " + 父目录;
        返回 0;
    }
    变量 条数: 整数 = 表列.字符串列表大小(依赖表);
    变量 i: 整数 = 0;
    当 (i + 1 < 条数) {
        变量 别名: 字符串 = 表列.获取字符串(依赖表, i);
        变量 版本: 字符串 = 表列.获取字符串(依赖表, i + 1);
        i = i + 2;

        如果 (版本合法(版本) == 0) {
            上次安装错 = "依赖 `" + 别名 + "` 的版本 \"" + 版本
                + "\" 不是「主.次.补」三段数字。\n  v1 只支持精确版本（不做 ^1.2 这类范围解析），请写成如 0.1.0";
            返回 0;
        }

        变量 包目录: 字符串 = 父目录 + "/qi_packages/" + 别名;
        // 同名同版本在树里出现多次（菱形依赖）只递归一次，但每个需要它的父包底下
        // 都得有一份 —— 所以「已见」只用来剪掉**递归**，不跳过落地。
        变量 键: 字符串 = 别名 + "@" + 版本;
        变量 见过: 整数 = 表里含(已见, 键);

        变量 钉死指纹: 字符串 = "";
        如果 (深度 == 0) {
            如果 (字符串::等于(锁定版本(锁表, 别名), 版本) == 1) {
                钉死指纹 = 锁定指纹(锁表, 别名);
            }
        }

        变量 结局: 整数 = 安装一个包(别名, 版本, 包目录, 钉死指纹);
        如果 (结局 < 0) {
            上次安装错 = "安装 " + 别名 + " " + 版本 + " 失败: " + 上次安装错;
            返回 0;
        }
        如果 (结局 == 0) {
            IO.打印行(缩进(深度) + 别名 + " 已是 " + 版本);
            计_跳过 = 计_跳过 + 1;
        } 否则 {
            IO.打印行(缩进(深度) + "已安装 " + 别名 + " " + 版本 + " ("
                + 结局 + " 个文件) → " + 包目录);
            如果 (详细模式 == 1) {
                IO.打印行(缩进(深度) + "  sha256 " + 标记取值(包目录, "sha256"));
            }
            计_装了 = 计_装了 + 1;
        }

        如果 (见过 == 0) {
            表列.添加字符串(已见, 键);
            // 装好的包自己带 qi.toml —— 里面声明的注册中心依赖接着装进它的 qi_packages
            如果 (IO.文件存在(包目录 + "/qi.toml") == 1) {
                变量 子依赖: 整数 = 注册中心依赖(IO.读取文件(包目录 + "/qi.toml"));
                如果 (表列.字符串列表大小(子依赖) > 0) {
                    如果 (装一层(子依赖, 包目录, 锁表, 深度 + 1, 已见) == 0) {
                        表列.删除列表(子依赖);
                        返回 0;
                    }
                }
                表列.删除列表(子依赖);
            }
        }
    }
    返回 1;
}

// ══════════════════════════════════════════════════════════════════
// 收集已装的包，给写 qi.lock 用
// ══════════════════════════════════════════════════════════════════

// 从 父目录/qi_packages 往下走，把每个带安装标记的包收成五元组：
// 名称, 版本, 来源, 路径, sha256。名称取包自己 qi.toml 里的 [包] 名称（跟 Rust 版一致）。
公开 函数 收集已装(父目录: 字符串, 结果值: 整数, 深度: 整数) {
    如果 (深度 > 依赖最大层数) { 返回; }
    变量 包根: 字符串 = 父目录 + "/qi_packages";
    如果 (系统.是否为目录(包根) == 0) { 返回; }
    // 2.0 起 列出目录 直接给列表句柄，不用再 拆行
    变量 名表: 整数 = 系统.列出目录(包根);
    如果 (名表 < 0) { 返回; }
    变量 个数: 整数 = 表列.字符串列表大小(名表);
    变量 i: 整数 = 0;
    当 (i < 个数) {
        变量 别名: 字符串 = 表列.获取字符串(名表, i);
        i = i + 1;
        如果 (字符串::字节长度(别名) > 0 && 字符串::开始于(别名, ".") == 0) {
            变量 包目录: 字符串 = 包根 + "/" + 别名;
            如果 (有标记(包目录) == 1) {
                变量 名: 字符串 = 包名(IO.读取文件(包目录 + "/qi.toml"));
                如果 (字符串::字节长度(名) == 0) { 名 = 别名; }
                表列.添加字符串(结果值, 名);
                表列.添加字符串(结果值, 标记取值(包目录, "版本"));
                表列.添加字符串(结果值, 标记取值(包目录, "来源"));
                表列.添加字符串(结果值, 包目录);
                表列.添加字符串(结果值, 标记取值(包目录, "sha256"));
                收集已装(包目录, 结果值, 深度 + 1);
            }
        }
    }
    表列.删除列表(名表);
}
