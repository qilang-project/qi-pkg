// 归档层单测：八进制 / 头字段 / 校验和 / 中文名 / 长路径 / 往返 / 排除规则
包 主程序;

导入 标准库.输入输出 作为 IO;
导入 标准库.字节切片 作为 字节库;
导入 标准库.字符串;
导入 标准库.列表 作为 表列;
导入 标准库.操作系统 作为 系统;
导入 Pkg::{八进制, 应排除, 路径序比较, 追加条目, 收尾, 打成tar, 打包, 解tar, 解包,
           头里取名, 头里取大小, 头校验和对, 路径越界, 读包内清单, 是包根清单,
           像gzip, 收集文件, SHA256十六进制, SHA256文本};

变量 通过数: 整数 = 0;
变量 失败数: 整数 = 0;

函数 断言(条件: 整数, 说明: 字符串) {
    如果 (条件 == 1) {
        通过数 = 通过数 + 1;
    } 否则 {
        失败数 = 失败数 + 1;
        IO.打印行("  ✗ " + 说明);
    }
}

函数 断言文本(实际: 字符串, 期望: 字符串, 说明: 字符串) {
    如果 (字符串::等于(实际, 期望) == 1) {
        通过数 = 通过数 + 1;
    } 否则 {
        失败数 = 失败数 + 1;
        IO.打印行("  ✗ " + 说明 + "：期望「" + 期望 + "」实际「" + 实际 + "」");
    }
}

函数 断言数(实际: 整数, 期望: 整数, 说明: 字符串) {
    如果 (实际 == 期望) {
        通过数 = 通过数 + 1;
    } 否则 {
        失败数 = 失败数 + 1;
        IO.打印行("  ✗ " + 说明 + "：期望 " + 期望 + " 实际 " + 实际);
    }
}

函数 测八进制() {
    断言文本(八进制(420, 7), "0000644", "mode 0644");
    断言文本(八进制(0, 11), "00000000000", "零");
    断言文本(八进制(8, 7), "0000010", "8 = 010");
    断言文本(八进制(511, 7), "0000777", "511 = 0777");
    断言文本(八进制(1234, 11), "00000002322", "1234 = 02322");
}

函数 测排除() {
    断言(应排除(".git/HEAD"), ".git 整棵剪掉");
    断言(应排除("target/debug/x"), "target");
    断言(应排除("target-wt/x"), "target-wt");
    断言(应排除("qi_packages/别的包/a.qi"), "qi_packages");
    断言(应排除("tests/断言.sh"), "tests");
    断言(应排除("深/一层/tests/x.qi"), "深层 tests");
    断言(应排除("a.o"), ".o 产物");
    断言(应排除(".DS_Store"), ".DS_Store");
    断言(应排除("qi.lock"), "qi.lock 不进包");
    断言(应排除(".qi_registry.toml"), "安装标记不进包");
    断言(应排除("../越界.qi"), "父目录段");
    断言数(应排除("qi.toml"), 0, "qi.toml 要进包");
    断言数(应排除("子目录/工具.qi"), 0, "普通源码");
    断言数(应排除("mytests/x.qi"), 0, "名字含 tests 但不是整段的不误伤");
    断言数(应排除("测试/归档_测.qi"), 0, "中文测试目录不在排除表里");
}

函数 测路径序() {
    // Path 序：分隔符比任何真实字节都小
    断言数(路径序比较("a/b", "a.txt"), -1, "a/b 排在 a.txt 前");
    断言数(路径序比较("a/b", "ab"), -1, "a/b 排在 ab 前");
    断言数(路径序比较("qi.toml", "命令行/主程序.qi"), -1, "ASCII 排在中文前");
    断言数(路径序比较("同", "同"), 0, "相等");
    断言数(路径序比较("b", "a"), 1, "b 在 a 后");
}

函数 测越界() {
    断言(路径越界("../越界.txt"), "相对越界");
    断言(路径越界("子目录/../../越界.txt"), "深一层越界");
    断言(路径越界("/tmp/越界.txt"), "绝对路径");
    断言(路径越界("C:/越界.txt"), "盘符");
    断言(路径越界("..\\越界.txt"), "反斜杠");
    断言数(路径越界("正常.txt"), 0, "普通路径");
    断言数(路径越界("子/目录/正常.qi"), 0, "多层普通路径");
}

函数 测包根清单() {
    断言(是包根清单("qi.toml"), "qi.toml");
    断言(是包根清单("./qi.toml"), "./qi.toml");
    断言(是包根清单("包名/qi.toml"), "一层目录");
    断言数(是包根清单("子/目/qi.toml"), 0, "两层不认");
    断言数(是包根清单("qi.tomlx"), 0, "近似名不认");
}

函数 测SHA256() {
    断言文本(SHA256文本(""),
        "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "空串");
    断言文本(SHA256文本("abc"),
        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", "abc");
    断言文本(SHA256文本("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"),
        "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1", "FIPS 双块向量");
    // 中文（UTF-8 字节）
    断言文本(SHA256文本("奇语"),
        "e8601e2edbd179ac967fba90c118b28f14feeb0b8bc000cae9c5406e6ebfd9a1", "中文 UTF-8 字节");
}

// 造一棵小目录树
函数 造包(根: 字符串) {
    IO.创建目录(根 + "/子目录");
    IO.创建目录(根 + "/target");
    IO.创建目录(根 + "/tests");
    IO.创建目录(根 + "/.git");
    IO.写入文件(根 + "/qi.toml", "[包]\n名称 = \"试验包\"\n版本 = \"0.1.0\"\n");
    IO.写入文件(根 + "/试验包.qi", "包 试验包;\n");
    IO.写入文件(根 + "/子目录/工具.qi", "包 试验包.工具;\n");
    IO.写入文件(根 + "/垃圾.o", "obj");
    IO.写入文件(根 + "/target/产物", "bin");
    IO.写入文件(根 + "/tests/测.qi", "测试");
    IO.写入文件(根 + "/.git/HEAD", "ref");
}

函数 测打包往返(临时根: 字符串) {
    变量 源: 字符串 = 临时根 + "/源";
    造包(源);

    变量 文件表: 整数 = 收集文件(源);
    断言数(表列.字符串列表大小(文件表), 3, "只收 qi.toml / 试验包.qi / 子目录/工具.qi");
    // 排序后：qi.toml < 子目录/工具.qi < 试验包.qi（按字节，ASCII 在中文前）
    断言文本(表列.获取字符串(文件表, 0), "qi.toml", "第一条是 qi.toml");
    表列.删除列表(文件表);

    变量 tar切片: 整数 = 打成tar(源);
    断言(tar切片 >= 0, "打 tar 成功");
    断言数(字节库.长度(tar切片) % 512, 0, "tar 长度是 512 的倍数");
    断言(头校验和对(tar切片, 0), "第一个头校验和自洽");
    断言文本(头里取名(tar切片, 0), "qi.toml", "第一条条目名");
    断言数(头里取大小(tar切片, 0), 44, "qi.toml 大小");

    变量 包体: 整数 = 打包(源);
    断言(像gzip(包体), "打出来的是 gzip");

    变量 目标: 字符串 = 临时根 + "/装到这";
    变量 数量: 整数 = 解包(包体, 目标);
    断言数(数量, 3, "解出 3 个文件");
    断言(IO.文件存在(目标 + "/qi.toml"), "qi.toml 落地");
    断言(IO.文件存在(目标 + "/试验包.qi"), "中文文件名落地");
    断言(IO.文件存在(目标 + "/子目录/工具.qi"), "子目录落地");
    断言数(IO.文件存在(目标 + "/target/产物"), 0, "target 没进包");
    断言数(IO.文件存在(目标 + "/tests/测.qi"), 0, "tests 没进包");
    断言数(IO.文件存在(目标 + "/垃圾.o"), 0, ".o 没进包");
    断言文本(IO.读取文件(目标 + "/子目录/工具.qi"), "包 试验包.工具;\n", "内容逐字节一致");

    变量 清单: 字符串 = 读包内清单(包体);
    断言(字符串::包含(清单, "试验包"), "读包内清单");

    // 确定性：同样内容打两次字节一致
    变量 源二: 字符串 = 临时根 + "/源二";
    造包(源二);
    变量 甲: 整数 = 打成tar(源);
    变量 乙: 整数 = 打成tar(源二);
    断言数(字节库.比较(甲, 乙), 0, "同样内容打两次逐字节一致");
    字节库.释放切片(甲);
    字节库.释放切片(乙);

    字节库.释放切片(tar切片);
    字节库.释放切片(包体);
}

// 长路径（> 99 字节）走 GNU 长名。中文名一个字 3 字节，34 个字就撞线。
函数 测长中文名(临时根: 字符串) {
    变量 源: 字符串 = 临时根 + "/长名源";
    变量 深: 字符串 = "非常非常非常非常长的中文目录名字用来把路径顶过一百个字节";
    IO.创建目录(源 + "/" + 深);
    变量 长文件: 字符串 = 深 + "/再来一个很长很长很长很长的中文文件名.qi";
    IO.写入文件(源 + "/qi.toml", "[包]\n名称 = \"长名\"\n");
    IO.写入文件(源 + "/" + 长文件, "包 长名;\n");
    断言(字符串::字节长度(长文件) >= 100, "路径确实超过 99 字节");

    变量 包体: 整数 = 打包(源);
    变量 目标: 字符串 = 临时根 + "/长名装到这";
    变量 数量: 整数 = 解包(包体, 目标);
    断言数(数量, 2, "长名包解出 2 个文件");
    断言(IO.文件存在(目标 + "/" + 长文件), "GNU 长名往返");
    断言文本(IO.读取文件(目标 + "/" + 长文件), "包 长名;\n", "长名文件内容一致");
    字节库.释放切片(包体);
}

// 手搓一个越界条目，验证解包会拒绝（注册中心返回的字节不可信）
函数 测拒绝越界(临时根: 字符串) {
    变量 坏tar: 整数 = 字节库.创建();
    变量 内容: 整数 = 字节库.从字符串("坏东西");
    追加条目(坏tar, "../越界.txt", 内容);
    收尾(坏tar);
    断言数(解tar(坏tar, 临时根 + "/拒绝"), -1, "越界路径被拒");
    断言数(IO.文件存在(临时根 + "/越界.txt"), 0, "没有真写出去");
    字节库.释放切片(内容);
    字节库.释放切片(坏tar);

    // 手搓样本本身要是合法的，上面那条断言才有意义
    变量 好tar: 整数 = 字节库.创建();
    变量 内容二: 整数 = 字节库.从字符串("内容");
    追加条目(好tar, "正常.txt", 内容二);
    收尾(好tar);
    断言数(解tar(好tar, 临时根 + "/接受"), 1, "合法样本能解开");
    断言文本(IO.读取文件(临时根 + "/接受/正常.txt"), "内容", "合法样本内容一致");
    字节库.释放切片(内容二);
    字节库.释放切片(好tar);
}

函数 入口() {
    变量 临时根: 字符串 = 系统.临时目录() + "/qipkg测-" + 系统.进程ID();
    IO.创建目录(临时根);

    测八进制();
    测排除();
    测路径序();
    测越界();
    测包根清单();
    测SHA256();
    测打包往返(临时根);
    测长中文名(临时根);
    测拒绝越界(临时根);

    IO.删除目录(临时根);
    IO.打印行("归档_测：通过 " + 通过数 + "，失败 " + 失败数);
    如果 (失败数 > 0) {
        系统.退出程序(1);
    }
}
