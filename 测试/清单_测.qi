// 清单层单测：TOML 取值 / 依赖枚举 / 逐行改写 / qi.lock 读写 / 安装标记
包 主程序;

导入 标准库.输入输出 作为 IO;
导入 标准库.字符串;
导入 标准库.列表 作为 表列;
导入 标准库.操作系统 作为 系统;
导入 标准库.路径 作为 路径库;
导入 Pkg::{拆行, 去引号, 节头名, 是数组节头, 行键, 行字符串值, 节内取值, 节内键值,
           包名, 包版本, 包描述, 版本合法, 注册中心依赖, 依赖总数, 文本序,
           写依赖, 找项目根, 有标记, 标记取值, 写标记,
           锁定表, 锁定版本, 锁定指纹, 写锁文件};

变量 通过数: 整数 = 0;
变量 失败数: 整数 = 0;

函数 断言(条件: 整数, 说明: 字符串) {
    如果 (条件 == 1) { 通过数 = 通过数 + 1; }
    否则 { 失败数 = 失败数 + 1; IO.打印行("  ✗ " + 说明); }
}

函数 断言文本(实际: 字符串, 期望: 字符串, 说明: 字符串) {
    如果 (字符串::等于(实际, 期望) == 1) { 通过数 = 通过数 + 1; }
    否则 {
        失败数 = 失败数 + 1;
        IO.打印行("  ✗ " + 说明 + "：期望「" + 期望 + "」实际「" + 实际 + "」");
    }
}

函数 断言数(实际: 整数, 期望: 整数, 说明: 字符串) {
    如果 (实际 == 期望) { 通过数 = 通过数 + 1; }
    否则 {
        失败数 = 失败数 + 1;
        IO.打印行("  ✗ " + 说明 + "：期望 " + 期望 + " 实际 " + 实际);
    }
}

函数 样例清单() : 字符串 {
    返回 "# 我的项目\n[包]\n名称 = \"主程序\" # 别动\n版本 = \"0.2.0\"\n\n"
        + "[元数据]\n描述 = \"一个试验包\"\n\n"
        + "[依赖]\n本地 = \"../本地\"\n海龟 = \"0.1.0\"\nKV = \"0.1.0\"\n"
        + "详细 = { 路径 = \"../详细\" }\n\n[源码]\n目录 = [\".\"]\n";
}

函数 测行级() {
    断言文本(节头名("[包]"), "包", "裸节头");
    断言文本(节头名("[\"依赖\"]"), "依赖", "带引号节头");
    断言文本(节头名("[[包]]"), "包", "数组节头");
    断言文本(节头名("[[\"包\".\"依赖\"]]"), "包.依赖", "点分数组节头");
    断言文本(节头名("名称 = \"x\""), "", "不是节头");
    断言数(是数组节头("[[包]]"), 1, "认出数组节头");
    断言数(是数组节头("[包]"), 0, "单表头不是数组节头");
    断言文本(行键("名称 = \"x\""), "名称", "裸键");
    断言文本(行键("\"名称\" = \"x\""), "名称", "带引号键");
    断言文本(行键("# 注释 = 1"), "", "注释行没有键");
    断言文本(行键("  格式版本 = 1"), "格式版本", "带前导空白");
    断言文本(行字符串值("名称 = \"小奇\""), "小奇", "字符串值");
    断言文本(行字符串值("格式版本 = 1"), "", "数字值取不出字符串");
    断言文本(行字符串值("详细 = { 路径 = \"../x\" }"), "", "内联表不算字符串值");
    断言文本(去引号("\"甲\""), "甲", "去引号");
    断言文本(去引号(" 乙 "), "乙", "去空白");
}

函数 测取值() {
    变量 文本: 字符串 = 样例清单();
    断言文本(包名(文本), "主程序", "[包] 名称（行尾有注释也要取对）");
    断言文本(包版本(文本), "0.2.0", "[包] 版本");
    断言文本(包描述(文本), "一个试验包", "[元数据] 描述");
    断言文本(节内取值(文本, "依赖", "海龟"), "0.1.0", "跨节取值不串台");
    断言文本(节内取值(文本, "包", "海龟"), "", "别的节里没有就是没有");
    断言数(依赖总数(文本), 4, "依赖共 4 条");
}

函数 测依赖枚举() {
    变量 表: 整数 = 注册中心依赖(样例清单());
    断言数(表列.字符串列表大小(表), 4, "只有 2 条是注册中心依赖（别名+版本 = 4 项）");
    // 按别名排序：KV 在 海龟 前（ASCII < 中文）
    断言文本(表列.获取字符串(表, 0), "KV", "排序后第一个是 KV");
    断言文本(表列.获取字符串(表, 1), "0.1.0", "KV 的版本");
    断言文本(表列.获取字符串(表, 2), "海龟", "第二个是 海龟");
    表列.删除列表(表);

    断言数(版本合法("0.1.0"), 1, "0.1.0");
    断言数(版本合法("2026.9.6"), 1, "三段就行，不管多大");
    断言数(版本合法("1.0"), 0, "两段不算");
    断言数(版本合法("v1.0.0"), 0, "带 v 不算");
    断言数(版本合法("../本地"), 0, "路径不算");
    断言数(版本合法("0.1.0-beta"), 0, "预发布不算");
    断言数(版本合法(""), 0, "空串不算");

    断言(文本序("KV", "海龟") < 0, "ASCII 排在中文前");
    断言数(文本序("同", "同"), 0, "相等");
    断言(文本序("b", "a") > 0, "b 在 a 后");
}

函数 测写依赖(临时根: 字符串) {
    // 新建 [依赖] 表
    变量 甲: 字符串 = 临时根 + "/甲.toml";
    IO.写入文件(甲, "[包]\n名称 = \"主程序\"\n");
    写依赖(甲, "海龟", "0.1.0");
    断言(字符串::包含(IO.读取文件(甲), "[依赖]\n海龟 = \"0.1.0\""), "没有 [依赖] 就建一个");

    // 保留注释与其他表，追加到表末尾
    变量 乙: 字符串 = 临时根 + "/乙.toml";
    IO.写入文件(乙, 样例清单());
    写依赖(乙, "Graph", "0.3.0");
    变量 乙后: 字符串 = IO.读取文件(乙);
    断言(字符串::包含(乙后, "# 我的项目"), "保留头部注释");
    断言(字符串::包含(乙后, "名称 = \"主程序\" # 别动"), "保留行尾注释");
    断言(字符串::包含(乙后, "本地 = \"../本地\""), "保留本地依赖");
    断言(字符串::包含(乙后, "[源码]"), "保留其他表");
    断言(字符串::包含(乙后, "Graph = \"0.3.0\""), "新依赖写进去了");
    断言文本(节内取值(乙后, "依赖", "Graph"), "0.3.0", "新依赖在 [依赖] 表里，不是掉到别处");

    // 同名原地替换
    写依赖(乙, "海龟", "0.9.0");
    变量 乙再: 字符串 = IO.读取文件(乙);
    断言文本(节内取值(乙再, "依赖", "海龟"), "0.9.0", "同名替换");
    断言数(字符串::包含(乙再, "海龟 = \"0.1.0\""), 0, "老版本没了");
    断言数(依赖总数(乙再), 5, "替换不该多出一条");
}

函数 测标记(临时根: 字符串) {
    变量 包目录: 字符串 = 临时根 + "/某包";
    IO.创建目录(包目录);
    断言数(有标记(包目录), 0, "还没装");
    写标记(包目录, "海龟", "0.1.0", "abc123", "https://pkg.qilang.org");
    断言数(有标记(包目录), 1, "写了标记");
    断言文本(标记取值(包目录, "名称"), "海龟", "标记 名称");
    断言文本(标记取值(包目录, "版本"), "0.1.0", "标记 版本");
    断言文本(标记取值(包目录, "sha256"), "abc123", "标记 sha256");
    断言文本(标记取值(包目录, "来源"), "https://pkg.qilang.org", "标记 来源");
    // Rust 那边写的是带引号的键，人手改成裸键也该认
    IO.写入文件(包目录 + "/.qi_registry.toml",
        "名称 = \"海龟\"\n版本 = \"0.2.0\"\nsha256 = \"def\"\n来源 = \"x\"\n");
    断言文本(标记取值(包目录, "版本"), "0.2.0", "裸键形式也认");
}

// Rust 版 qi.lock 的真实形状：根包带 [["根包"."依赖"]]，每个包后面跟 [["包"."依赖"]]。
// 那些子表里也有 名称/版本/sha256 —— 认错了就会把依赖条目当成包条目多算一遍。
函数 Rust版lock() : 字符串 {
    返回 "\"格式版本\" = 1\n\n[\"根包\"]\n\"名称\" = \"演示\"\n\"版本\" = \"0.1.0\"\n"
        + "\"来源\" = \"workspace\"\n\"路径\" = \"/tmp/演示\"\n\n"
        + "[[\"根包\".\"依赖\"]]\n\"别名\" = \"Graph\"\n\"名称\" = \"Graph\"\n"
        + "\"版本\" = \"0.1.0\"\n\"路径\" = \"/tmp/演示/qi_packages/Graph\"\n"
        + "\"来源\" = \"https://pkg.qilang.org\"\nsha256 = \"aaa\"\n\n"
        + "[[\"包\"]]\n\"名称\" = \"Graph\"\n\"版本\" = \"0.1.0\"\n"
        + "\"来源\" = \"https://pkg.qilang.org\"\n\"路径\" = \"/tmp/演示/qi_packages/Graph\"\n"
        + "sha256 = \"aaa\"\n\n"
        + "[[\"包\".\"依赖\"]]\n\"别名\" = \"KV\"\n\"名称\" = \"KV\"\n\"版本\" = \"0.1.0\"\n"
        + "\"来源\" = \"https://pkg.qilang.org\"\nsha256 = \"bbb\"\n\n"
        + "[[\"包\"]]\n\"名称\" = \"KV\"\n\"版本\" = \"0.1.0\"\n"
        + "\"来源\" = \"https://pkg.qilang.org\"\n"
        + "\"路径\" = \"/tmp/演示/qi_packages/Graph/qi_packages/KV\"\nsha256 = \"bbb\"\n"
        + "\n[[\"包\"]]\n\"名称\" = \"本地包\"\n\"来源\" = \"path\"\n\"路径\" = \"/tmp/本地\"\n";
}

函数 测锁(临时根: 字符串) {
    变量 项目: 字符串 = 临时根 + "/锁项目";
    IO.创建目录(项目);
    IO.写入文件(项目 + "/qi.lock", Rust版lock());
    变量 锁: 整数 = 锁定表(项目);
    断言数(表列.字符串列表大小(锁) / 4, 2, "只认 [[包]] 里的注册中心条目（path 的不算）");
    断言文本(锁定版本(锁, "Graph"), "0.1.0", "查 Graph 版本");
    断言文本(锁定指纹(锁, "Graph"), "aaa", "查 Graph 指纹");
    断言文本(锁定指纹(锁, "KV"), "bbb", "查 KV 指纹");
    断言文本(锁定指纹(锁, "不存在"), "", "查不到就是空");
    表列.删除列表(锁);

    // 自己写一份再读回来
    变量 项目二: 字符串 = 临时根 + "/锁项目二";
    IO.创建目录(项目二);
    变量 条目: 整数 = 表列.创建字符串列表();
    表列.添加字符串(条目, "海龟");
    表列.添加字符串(条目, "0.1.0");
    表列.添加字符串(条目, "https://pkg.qilang.org");
    表列.添加字符串(条目, 项目二 + "/qi_packages/海龟");
    表列.添加字符串(条目, "ccc");
    写锁文件(项目二, "演示", "0.1.0", 条目);
    表列.删除列表(条目);
    变量 锁二: 整数 = 锁定表(项目二);
    断言数(表列.字符串列表大小(锁二) / 4, 1, "往返一条");
    断言文本(锁定指纹(锁二, "海龟"), "ccc", "中文包名往返");
    表列.删除列表(锁二);
    断言(字符串::包含(IO.读取文件(项目二 + "/qi.lock"), "\"格式版本\" = 1"), "格式版本头");
    断言(字符串::包含(IO.读取文件(项目二 + "/qi.lock"), "[\"根包\"]"), "根包表");

    // 没有 lock 就是空表，不该报错
    变量 空锁: 整数 = 锁定表(临时根 + "/根本没有这个目录");
    断言数(表列.字符串列表大小(空锁), 0, "没有 lock 返回空表");
    表列.删除列表(空锁);
}

函数 测找项目根(临时根: 字符串) {
    变量 上: 字符串 = 临时根 + "/工程";
    变量 下: 字符串 = 上 + "/子/孙";
    IO.创建目录(下);
    IO.写入文件(上 + "/qi.toml", "[包]\n名称 = \"工程\"\n");
    // 找项目根 返回的是规范化路径（macOS 上 /var 是 /private/var 的软链）
    变量 上规范: 字符串 = 路径库.绝对路径(上);
    断言文本(找项目根(下), 上规范, "从孙目录往上找到 qi.toml");
    断言文本(找项目根(上), 上规范, "本目录就有");
}

函数 入口() {
    变量 临时根: 字符串 = 系统.临时目录() + "/qipkg清单测-" + 系统.进程ID();
    IO.创建目录(临时根);

    测行级();
    测取值();
    测依赖枚举();
    测写依赖(临时根);
    测标记(临时根);
    测锁(临时根);
    测找项目根(临时根);

    IO.删除目录(临时根);
    IO.打印行("清单_测：通过 " + 通过数 + "，失败 " + 失败数);
    如果 (失败数 > 0) { 系统.退出程序(1); }
}
