// 注册中心层单测：只测不联网的部分（URL 转义、地址解析、错误原因抽取）。
// 真正走网的部分在 测试/端到端.sh 里对着假注册中心跑。
包 主程序;

导入 标准库.输入输出 作为 IO;
导入 标准库.字符串;
导入 标准库.操作系统 作为 系统;
导入 Pkg::{转义路径段, 地址, 默认地址, 令牌环境变量};

变量 通过数: 整数 = 0;
变量 失败数: 整数 = 0;

函数 断言文本(实际: 字符串, 期望: 字符串, 说明: 字符串) {
    如果 (字符串::等于(实际, 期望) == 1) { 通过数 = 通过数 + 1; }
    否则 {
        失败数 = 失败数 + 1;
        IO.打印行("  ✗ " + 说明 + "：期望「" + 期望 + "」实际「" + 实际 + "」");
    }
}

函数 入口() {
    // 中文按 UTF-8 字节逐个 %XX（大写十六进制），跟 Rust 的 utf8_percent_encode 一致
    断言文本(转义路径段("海龟"), "%E6%B5%B7%E9%BE%9F", "中文包名");
    断言文本(转义路径段("0.1.0"), "0.1.0", "版本号原样");
    断言文本(转义路径段("qi-web"), "qi-web", "ASCII 包名原样");
    断言文本(转义路径段("Graph_2~x.y"), "Graph_2~x.y", "unreserved 原样");
    // 结构性字符必须转，否则会撕开路径
    断言文本(转义路径段("a/b"), "a%2Fb", "斜杠");
    断言文本(转义路径段("a b"), "a%20b", "空格");
    断言文本(转义路径段("a?b"), "a%3Fb", "问号");
    断言文本(转义路径段("a#b"), "a%23b", "井号");
    断言文本(转义路径段("a%b"), "a%25b", "已含 % 的名字不能二次歧义");

    断言文本(令牌环境变量(), "QI_REGISTRY_TOKEN", "token 环境变量名");

    系统.删除环境变量("QI_REGISTRY");
    断言文本(地址(), 默认地址(), "不设环境变量走默认值");
    系统.设置环境变量("QI_REGISTRY", "http://127.0.0.1:43510/");
    断言文本(地址(), "http://127.0.0.1:43510", "覆盖并去掉尾斜杠");
    系统.设置环境变量("QI_REGISTRY", "   ");
    断言文本(地址(), 默认地址(), "全空白当没设");
    系统.删除环境变量("QI_REGISTRY");

    IO.打印行("注册中心_测：通过 " + 通过数 + "，失败 " + 失败数);
    如果 (失败数 > 0) { 系统.退出程序(1); }
}
