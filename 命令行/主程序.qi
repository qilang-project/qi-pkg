// qipkg —— qi 包管理客户端（用奇语自己写的）
//
//   qipkg 安装                装齐当前项目 qi.toml [依赖] 里的注册中心包（含传递依赖）
//   qipkg 添加 Graph          写进 qi.toml [依赖] 并立即安装，省略版本取最新
//   qipkg 发布 --只打包       打包当前目录；不加 --只打包 就 PUT 上去
//   qipkg 搜索 存储           按名称/描述过滤包列表
//   qipkg 列出                列出本项目已装的注册中心包
//
// 注册中心默认 https://pkg.qilang.org，环境变量 QI_REGISTRY 覆盖；
// 发布 token 读环境变量 QI_REGISTRY_TOKEN。

包 主程序;

导入 标准库.输入输出 作为 IO;
导入 标准库.字符串;
导入 标准库.字节切片 作为 字节库;
导入 标准库.列表 作为 表列;
导入 标准库.操作系统 作为 系统;
导入 CLI::{
    创建应用, 创建命令, 创建参数, 执行, 上下文, 应用, 命令, 参数,
    应用版本, 应用作者, 应用简介, 应用执行, 应用添加参数, 应用添加命令,
    命令简介, 命令示例, 命令执行, 命令添加参数, 命令添加别名,
    参数长名, 参数短名, 参数帮助, 参数标志, 参数持久,
    值, 标志
};
导入 Pkg::{
    打包, 读包内清单, SHA256十六进制,
    包名, 包版本, 版本合法, 注册中心依赖, 依赖总数, 写依赖, 找项目根,
    有标记, 标记取值, 锁定表, 锁定版本, 写锁文件, 拆行,
    地址, 令牌环境变量, 列出包, 状态码, 网络错, 错误原因, 发布包体,
    安装一个包, 装一层, 安装错, 装了几个, 跳过几个, 设详细, 收集已装
};

// ══════════════════════════════════════════════════════════════════
// 公共
// ══════════════════════════════════════════════════════════════════

// 从当前目录向上找项目 qi.toml，找不到打印提示返回 ""。
函数 本项目根() : 字符串 {
    变量 根: 字符串 = 找项目根(系统.当前目录());
    如果 (字符串::字节长度(根) == 0) {
        IO.打印错误行("当前目录及其上级没有找到 qi.toml。");
        IO.打印错误行("请在 Qi 项目目录内运行，或先创建 qi.toml。");
    }
    返回 根;
}

// 终端显示宽度：CJK / 全角标点算 2 格，其余算 1 格。
// 中文包名在终端占两格，按字符数对齐会歪一片。
函数 显示宽度(文本: 字符串) : 整数 {
    变量 宽: 整数 = 0;
    变量 片: 整数 = 字节库.从字符串(文本);
    变量 总长: 整数 = 字节库.长度(片);
    变量 i: 整数 = 0;
    当 (i < 总长) {
        变量 一字节: 整数 = 字节库.获取(片, i);
        如果 (一字节 < 128) {
            宽 = 宽 + 1;
            i = i + 1;
        } 否则 {
            // UTF-8 多字节：三字节起步的基本都落在 CJK / 全角区，算 2 格；
            // 两字节（拉丁扩展、希腊、西里尔）算 1 格。
            变量 长度: 整数 = 2;
            如果 (一字节 >= 240) { 长度 = 4; }
            否则 { 如果 (一字节 >= 224) { 长度 = 3; } }
            如果 (长度 >= 3) { 宽 = 宽 + 2; } 否则 { 宽 = 宽 + 1; }
            i = i + 长度;
        }
    }
    字节库.释放切片(片);
    返回 宽;
}

函数 补齐(文本: 字符串, 宽度: 整数) : 字符串 {
    变量 当前: 整数 = 显示宽度(文本);
    变量 输出: 字符串 = 文本;
    当 (当前 < 宽度) {
        输出 = 输出 + " ";
        当前 = 当前 + 1;
    }
    返回 输出;
}

// ══════════════════════════════════════════════════════════════════
// 安装
// ══════════════════════════════════════════════════════════════════

函数 安装到(项目根: 字符串) : 整数 {
    变量 清单文本: 字符串 = IO.读取文件(项目根 + "/qi.toml");
    变量 依赖表: 整数 = 注册中心依赖(清单文本);
    如果 (表列.字符串列表大小(依赖表) == 0) {
        表列.删除列表(依赖表);
        变量 其他: 整数 = 依赖总数(清单文本);
        如果 (其他 > 0) {
            IO.打印行("qi.toml 的 [依赖] 里没有注册中心依赖（" + 其他
                + " 条是本地路径或 git 依赖，用 qi get 拉取）");
        } 否则 {
            IO.打印行("qi.toml 的 [依赖] 是空的，没有要装的包");
        }
        返回 0;
    }

    // lock 优先：有 lock 就按 lock 里钉死的 sha256 校验，没有才纯按 qi.toml 装
    变量 锁表: 整数 = 锁定表(项目根);
    如果 (表列.字符串列表大小(锁表) > 0) {
        IO.打印行("按 qi.lock 校验（" + (表列.字符串列表大小(锁表) / 4) + " 条锁定记录）");
    }

    变量 已见: 整数 = 表列.创建字符串列表();
    变量 好: 整数 = 装一层(依赖表, 项目根, 锁表, 0, 已见);
    表列.删除列表(已见);
    表列.删除列表(锁表);
    如果 (好 == 0) {
        IO.打印错误行(安装错());
        表列.删除列表(依赖表);
        返回 1;
    }

    // 重新扫一遍装好的树，把元信息写进 qi.lock
    变量 条目表: 整数 = 表列.创建字符串列表();
    收集已装(项目根, 条目表, 0);
    变量 lock路径: 字符串 = 写锁文件(项目根, 根包名(清单文本), 包版本(清单文本), 条目表);
    表列.删除列表(条目表);

    IO.打印行("共 " + (表列.字符串列表大小(依赖表) / 2) + " 个依赖：新装 " + 装了几个()
        + "，跳过 " + 跳过几个() + "；已更新 " + lock路径);
    表列.删除列表(依赖表);
    返回 0;
}

函数 根包名(清单文本: 字符串) : 字符串 {
    变量 名: 字符串 = 包名(清单文本);
    如果 (字符串::字节长度(名) == 0) { 返回 "未命名包"; }
    返回 名;
}

函数 处理安装(上下文值: 上下文) : 整数 {
    设详细(标志(上下文值, "详细"));
    变量 根: 字符串 = 本项目根();
    如果 (字符串::字节长度(根) == 0) { 返回 1; }
    返回 安装到(根);
}

// ══════════════════════════════════════════════════════════════════
// 添加
// ══════════════════════════════════════════════════════════════════

// 问注册中心要某个包的最新版本号。找不到包时把「搜索」指出来，别只甩一个 404。
函数 解析最新版(名称: 字符串) : 字符串 {
    变量 全部: 整数 = 列出包();
    如果 (全部 < 0) {
        IO.打印错误行(网络错());
        返回 "";
    }
    变量 条数: 整数 = 表列.字符串列表大小(全部);
    变量 命中版本: 字符串 = "";
    变量 找到: 整数 = 0;
    变量 i: 整数 = 0;
    当 (i + 3 < 条数) {
        如果 (字符串::等于(表列.获取字符串(全部, i), 名称) == 1) {
            找到 = 1;
            命中版本 = 表列.获取字符串(全部, i + 1);
        }
        i = i + 4;
    }
    表列.删除列表(全部);
    如果 (找到 == 0) {
        IO.打印错误行("注册中心 " + 地址() + " 上没有名为 \"" + 名称 + "\" 的包。");
        IO.打印错误行("  用 qipkg 搜索 " + 名称 + " 看看有没有相近的");
        返回 "";
    }
    如果 (字符串::字节长度(命中版本) == 0) {
        IO.打印错误行("包 \"" + 名称 + "\" 在注册中心存在但还没有任何已发布版本");
        返回 "";
    }
    IO.打印行("解析 " + 名称 + " 最新版 → " + 命中版本);
    返回 命中版本;
}

函数 处理添加(上下文值: 上下文) : 整数 {
    设详细(标志(上下文值, "详细"));
    变量 名称: 字符串 = 值(上下文值, "名称");
    如果 (字符串::字节长度(名称) == 0) {
        IO.打印错误行("用法: qipkg 添加 <名称> [版本]");
        返回 1;
    }
    // 省略版本 = 取注册中心的最新版。解析出来的**具体版本号**才写进 qi.toml ——
    // 清单里始终是精确版本，重跑安装必然装到同一份，「最新」只发生在你敲命令那一刻。
    变量 版本: 字符串 = 值(上下文值, "版本");
    如果 (字符串::字节长度(版本) == 0) {
        版本 = 解析最新版(名称);
        如果 (字符串::字节长度(版本) == 0) { 返回 1; }
    }
    如果 (版本合法(版本) == 0) {
        IO.打印错误行("版本 \"" + 版本 + "\" 不是「主.次.补」三段数字。");
        IO.打印错误行("  v1 只支持精确版本，请写成如 0.1.0");
        返回 1;
    }

    变量 根: 字符串 = 本项目根();
    如果 (字符串::字节长度(根) == 0) { 返回 1; }
    写依赖(根 + "/qi.toml", 名称, 版本);
    IO.打印行("已写入依赖: " + 名称 + " = \"" + 版本 + "\" → " + 根 + "/qi.toml");
    返回 安装到(根);
}

// ══════════════════════════════════════════════════════════════════
// 发布
// ══════════════════════════════════════════════════════════════════

函数 处理发布(上下文值: 上下文) : 整数 {
    变量 根: 字符串 = 本项目根();
    如果 (字符串::字节长度(根) == 0) { 返回 1; }
    变量 清单文本: 字符串 = IO.读取文件(根 + "/qi.toml");
    变量 名称: 字符串 = 包名(清单文本);
    如果 (字符串::字节长度(名称) == 0) {
        IO.打印错误行(根 + "/qi.toml 里没有 [包] 名称，无法发布");
        返回 1;
    }
    变量 版本: 字符串 = 包版本(清单文本);
    如果 (字符串::字节长度(版本) == 0) {
        IO.打印错误行(根 + "/qi.toml 里没有 [包] 版本，无法发布");
        返回 1;
    }
    如果 (版本合法(版本) == 0) {
        IO.打印错误行("[包] 版本 \"" + 版本 + "\" 不是「主.次.补」三段数字，注册中心只收这种形式");
        返回 1;
    }

    变量 包体: 整数 = 打包(根);
    如果 (包体 < 0) {
        IO.打印错误行(根 + " 里没有可打包的文件（qi.toml 和 .qi 源码都被排除了？）");
        返回 1;
    }
    变量 指纹: 字符串 = SHA256十六进制(包体);
    IO.打印行("已打包 " + 名称 + " " + 版本 + "：" + 字节库.长度(包体)
        + " 字节，sha256 " + 指纹);
    如果 (标志(上下文值, "详细") == 1) {
        IO.打印行("  排除: .git target target-wt qi_packages tests");
    }

    // 自检：包里那份 qi.toml 必须跟发布地址一致，不然服务端会 400，
    // 与其等一个远程往返再报错，不如本地当场说清楚。
    如果 (字符串::字节长度(读包内清单(包体)) == 0) {
        IO.打印错误行("打出来的包里没有包根 qi.toml —— 这不该发生，请报 bug");
        字节库.释放切片(包体);
        返回 1;
    }

    变量 存到: 字符串 = 值(上下文值, "输出");
    如果 (字符串::字节长度(存到) > 0) {
        字节库.写入文件(包体, 存到);
        IO.打印行("包体已写到 " + 存到);
    }

    如果 (标志(上下文值, "只打包") == 1) {
        IO.打印行("（--只打包）没有发布，包体未上传");
        字节库.释放切片(包体);
        返回 0;
    }

    变量 令牌: 字符串 = 字符串::去空白(系统.获取环境变量(令牌环境变量()));
    如果 (字符串::字节长度(令牌) == 0) {
        IO.打印错误行("没有发布 token：请设置环境变量 " + 令牌环境变量());
        IO.打印错误行("  token 由注册中心管理员签发（v1 不做自助注册）");
        字节库.释放切片(包体);
        返回 1;
    }

    IO.打印行("发布到 " + 地址() + " …");
    变量 码: 整数 = 发布包体(名称, 版本, 包体, 令牌);
    字节库.释放切片(包体);
    如果 (码 >= 200 && 码 < 300) {
        IO.打印行("已发布 " + 名称 + " " + 版本 + " → " + 地址());
        返回 0;
    }
    如果 (码 == 0) {
        IO.打印错误行(网络错());
        返回 1;
    }
    如果 (码 == 409) {
        IO.打印错误行("该版本已发布过，版本号不可复用，请升版本：" + 名称 + " " + 版本
            + " 已存在于 " + 地址());
        IO.打印错误行("  改 qi.toml 的 [包] 版本 再发一次（服务端原因: " + 错误原因() + "）");
        返回 1;
    }
    如果 (码 == 401 || 码 == 403) {
        IO.打印错误行("发布被拒：token 无效或无权限（HTTP " + 码 + "）");
        IO.打印错误行("  检查环境变量 " + 令牌环境变量()
            + " 是否设成了注册中心签发的发布 token（服务端原因: " + 错误原因() + "）");
        返回 1;
    }
    如果 (码 == 400) {
        IO.打印错误行("发布被拒：包内容与 URL 不符（HTTP 400）");
        IO.打印错误行("  服务端会校验包里 qi.toml 的 名称/版本 跟发布地址一致（服务端原因: "
            + 错误原因() + "）");
        返回 1;
    }
    IO.打印错误行("发布失败（HTTP " + 码 + "）: " + 错误原因());
    返回 1;
}

// ══════════════════════════════════════════════════════════════════
// 搜索
// ══════════════════════════════════════════════════════════════════

函数 处理搜索(上下文值: 上下文) : 整数 {
    变量 关键词: 字符串 = 值(上下文值, "关键词");
    变量 全部: 整数 = 列出包();
    如果 (全部 < 0) {
        IO.打印错误行(网络错());
        返回 1;
    }
    变量 词: 字符串 = 字符串::转小写(关键词);
    变量 命中: 整数 = 表列.创建字符串列表();
    变量 条数: 整数 = 表列.字符串列表大小(全部);
    变量 i: 整数 = 0;
    当 (i + 3 < 条数) {
        变量 名: 字符串 = 表列.获取字符串(全部, i);
        变量 说明: 字符串 = 表列.获取字符串(全部, i + 2);
        如果 (字符串::字节长度(词) == 0
              || 字符串::包含(字符串::转小写(名), 词) == 1
              || 字符串::包含(字符串::转小写(说明), 词) == 1) {
            表列.添加字符串(命中, 名);
            表列.添加字符串(命中, 表列.获取字符串(全部, i + 1));
            表列.添加字符串(命中, 说明);
        }
        i = i + 4;
    }
    表列.删除列表(全部);

    变量 个数: 整数 = 表列.字符串列表大小(命中) / 3;
    如果 (个数 == 0) {
        表列.删除列表(命中);
        IO.打印行("在 " + 地址() + " 上没有匹配「" + 关键词 + "」的包");
        返回 0;
    }

    变量 名称宽: 整数 = 显示宽度("名称");
    变量 版本宽: 整数 = 显示宽度("最新版本");
    变量 j: 整数 = 0;
    当 (j < 个数) {
        变量 w1: 整数 = 显示宽度(表列.获取字符串(命中, j * 3));
        如果 (w1 > 名称宽) { 名称宽 = w1; }
        变量 v: 字符串 = 表列.获取字符串(命中, j * 3 + 1);
        如果 (字符串::字节长度(v) == 0) { v = "-"; }
        变量 w2: 整数 = 显示宽度(v);
        如果 (w2 > 版本宽) { 版本宽 = w2; }
        j = j + 1;
    }

    IO.打印行(补齐("名称", 名称宽) + "  " + 补齐("最新版本", 版本宽) + "  说明");
    j = 0;
    当 (j < 个数) {
        变量 v2: 字符串 = 表列.获取字符串(命中, j * 3 + 1);
        如果 (字符串::字节长度(v2) == 0) { v2 = "-"; }
        IO.打印行(补齐(表列.获取字符串(命中, j * 3), 名称宽) + "  "
            + 补齐(v2, 版本宽) + "  " + 表列.获取字符串(命中, j * 3 + 2));
        j = j + 1;
    }
    表列.删除列表(命中);
    IO.打印行("");
    IO.打印行("共 " + 个数 + " 个包（来自 " + 地址() + "）");
    IO.打印行("安装: qipkg 添加 <名称> <版本>");
    返回 0;
}

// ══════════════════════════════════════════════════════════════════
// 列出（本地已装）
// ══════════════════════════════════════════════════════════════════

函数 处理列出(上下文值: 上下文) : 整数 {
    变量 根: 字符串 = 本项目根();
    如果 (字符串::字节长度(根) == 0) { 返回 1; }
    变量 依赖表: 整数 = 注册中心依赖(IO.读取文件(根 + "/qi.toml"));
    变量 条数: 整数 = 表列.字符串列表大小(依赖表);
    如果 (条数 == 0) {
        表列.删除列表(依赖表);
        IO.打印行("qi.toml 里没有注册中心依赖");
        返回 0;
    }
    变量 i: 整数 = 0;
    当 (i + 1 < 条数) {
        变量 别名: 字符串 = 表列.获取字符串(依赖表, i);
        变量 版本: 字符串 = 表列.获取字符串(依赖表, i + 1);
        变量 包目录: 字符串 = 根 + "/qi_packages/" + 别名;
        如果 (有标记(包目录) == 1) {
            变量 已装: 字符串 = 标记取值(包目录, "版本");
            如果 (字符串::等于(已装, 版本) == 1) {
                IO.打印行(别名 + " " + 版本 + "  已装  " + 标记取值(包目录, "来源"));
                列出子依赖(包目录, 1);
            } 否则 {
                IO.打印行(别名 + " " + 版本 + "  版本不符（已装 " + 已装 + "），跑 qipkg 安装");
            }
        } 否则 {
            IO.打印行(别名 + " " + 版本 + "  未安装，跑 qipkg 安装");
        }
        i = i + 2;
    }
    表列.删除列表(依赖表);
    返回 0;
}

// 装在某个包底下的传递依赖，缩进一层列出来
函数 列出子依赖(包目录: 字符串, 深度: 整数) {
    如果 (深度 > 8) { 返回; }
    变量 子清单: 字符串 = IO.读取文件(包目录 + "/qi.toml");
    变量 子依赖: 整数 = 注册中心依赖(子清单);
    变量 条数: 整数 = 表列.字符串列表大小(子依赖);
    变量 i: 整数 = 0;
    当 (i + 1 < 条数) {
        变量 别名: 字符串 = 表列.获取字符串(子依赖, i);
        变量 版本: 字符串 = 表列.获取字符串(子依赖, i + 1);
        变量 子目录: 字符串 = 包目录 + "/qi_packages/" + 别名;
        变量 缩: 字符串 = "";
        变量 k: 整数 = 0;
        当 (k < 深度) { 缩 = 缩 + "  "; k = k + 1; }
        如果 (有标记(子目录) == 1) {
            IO.打印行(缩 + 别名 + " " + 标记取值(子目录, "版本") + "  已装（传递依赖）");
            列出子依赖(子目录, 深度 + 1);
        } 否则 {
            IO.打印行(缩 + 别名 + " " + 版本 + "  未安装，跑 qipkg 安装");
        }
        i = i + 2;
    }
    表列.删除列表(子依赖);
}

// ══════════════════════════════════════════════════════════════════

函数 处理根(上下文值: 上下文) : 整数 {
    IO.打印行("qipkg —— qi 包管理客户端。用 qipkg --help 看子命令。");
    IO.打印行("注册中心: " + 地址());
    返回 0;
}

函数 入口() {
    变量 应用值: 应用 = 创建应用("qipkg");
    应用值 = 应用版本(应用值, "0.1.0");
    应用值 = 应用作者(应用值, "Qi Language Team");
    应用值 = 应用简介(应用值, "qi 包管理客户端：安装 / 添加 / 发布 / 搜索 / 列出");
    应用值 = 应用执行(应用值, 处理根);

    变量 详细参数: 参数 = 创建参数("详细");
    详细参数 = 参数长名(详细参数, "详细");
    详细参数 = 参数短名(详细参数, "v");
    详细参数 = 参数帮助(详细参数, "多打点东西（sha256、排除表）");
    详细参数 = 参数标志(详细参数);
    详细参数 = 参数持久(详细参数);
    应用值 = 应用添加参数(应用值, 详细参数);

    // ---- 安装 ----
    变量 安装命令: 命令 = 创建命令("安装");
    安装命令 = 命令简介(安装命令, "装齐 qi.toml [依赖] 里的注册中心包（含传递依赖）");
    安装命令 = 命令示例(安装命令, "qipkg 安装");
    安装命令 = 命令添加别名(安装命令, "install");
    安装命令 = 命令执行(安装命令, 处理安装);
    应用值 = 应用添加命令(应用值, 安装命令);

    // ---- 添加 ----
    变量 添加命令: 命令 = 创建命令("添加");
    添加命令 = 命令简介(添加命令, "写进 qi.toml [依赖] 并立即安装（省略版本取最新）");
    添加命令 = 命令示例(添加命令, "qipkg 添加 Graph 0.1.0");
    添加命令 = 命令添加别名(添加命令, "add");
    添加命令 = 命令执行(添加命令, 处理添加);
    变量 名称参数: 参数 = 创建参数("名称");
    名称参数 = 参数帮助(名称参数, "包名（可为中文）");
    添加命令 = 命令添加参数(添加命令, 名称参数);
    变量 版本参数: 参数 = 创建参数("版本");
    版本参数 = 参数帮助(版本参数, "版本号 主.次.补，省略则取最新");
    添加命令 = 命令添加参数(添加命令, 版本参数);
    应用值 = 应用添加命令(应用值, 添加命令);

    // ---- 发布 ----
    变量 发布命令: 命令 = 创建命令("发布");
    发布命令 = 命令简介(发布命令, "打包当前目录并 PUT 上去（token 读 QI_REGISTRY_TOKEN）");
    发布命令 = 命令示例(发布命令, "qipkg 发布 --只打包");
    发布命令 = 命令添加别名(发布命令, "publish");
    发布命令 = 命令执行(发布命令, 处理发布);
    变量 只打包参数: 参数 = 创建参数("只打包");
    只打包参数 = 参数长名(只打包参数, "只打包");
    只打包参数 = 参数帮助(只打包参数, "只打包并报字节数与 sha256，不上传");
    只打包参数 = 参数标志(只打包参数);
    发布命令 = 命令添加参数(发布命令, 只打包参数);
    变量 输出参数: 参数 = 创建参数("输出");
    输出参数 = 参数长名(输出参数, "输出");
    输出参数 = 参数短名(输出参数, "o");
    输出参数 = 参数帮助(输出参数, "顺手把 tar.gz 写到这个路径");
    发布命令 = 命令添加参数(发布命令, 输出参数);
    应用值 = 应用添加命令(应用值, 发布命令);

    // ---- 搜索 ----
    变量 搜索命令: 命令 = 创建命令("搜索");
    搜索命令 = 命令简介(搜索命令, "按名称/描述过滤注册中心的包列表");
    搜索命令 = 命令示例(搜索命令, "qipkg 搜索 存储");
    搜索命令 = 命令添加别名(搜索命令, "search");
    搜索命令 = 命令执行(搜索命令, 处理搜索);
    变量 关键词参数: 参数 = 创建参数("关键词");
    关键词参数 = 参数帮助(关键词参数, "关键词（留空列全部）");
    搜索命令 = 命令添加参数(搜索命令, 关键词参数);
    应用值 = 应用添加命令(应用值, 搜索命令);

    // ---- 列出 ----
    变量 列出命令: 命令 = 创建命令("列出");
    列出命令 = 命令简介(列出命令, "看本项目 qi_packages 里都装了什么");
    列出命令 = 命令示例(列出命令, "qipkg 列出");
    列出命令 = 命令添加别名(列出命令, "list");
    列出命令 = 命令执行(列出命令, 处理列出);
    应用值 = 应用添加命令(应用值, 列出命令);

    // 执行 只返回退出码，不退进程 —— 得自己退
    系统.退出程序(执行(应用值));
}
